@@ -0,0 +1,23 @@
+// Shared integer-only mode bounds for both the transport and framebuffer.
+#ifndef HyperVGraphicsModeValidation_hpp
+#define HyperVGraphicsModeValidation_hpp
+
+static inline bool hyperVGraphicsResolutionFits(UInt64 width, UInt64 height,
+    UInt32 bytesPerPixel, UInt64 capacity, bool legacy16Bit) {
+  // The host's supported-resolution wire format uses 16-bit dimensions.
+  // Bound operands before any multiplication or narrowing conversion.
+  if (width < 640 || height < 480 || width > 65535 || height > 65535 ||
+      (bytesPerPixel != 2 && bytesPerPixel != 4)) return false;
+  if (legacy16Bit && (width > 1600 || height > 1200)) return false;
+  return width * height * bytesPerPixel <= capacity;
+}
+
+static inline bool hyperVGraphicsModeFits(UInt64 width, UInt64 height,
+    UInt64 refreshHz, UInt32 bytesPerPixel, UInt64 capacity, bool legacy16Bit) {
+  if (refreshHz < 24 || refreshHz > 240 ||
+      !hyperVGraphicsResolutionFits(width, height, bytesPerPixel, capacity, legacy16Bit))
+    return false;
+  // AGDC's pixel-clock field is 32-bit, even though detailed timing is 64-bit.
+  return (width + 160) * (height + 32) * refreshHz <= 0xffffffffULL;
+}
+#endif
