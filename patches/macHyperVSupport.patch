diff --git a/MacHyperVFramebuffer/HyperVGraphicsFramebufferPublication.cpp b/MacHyperVFramebuffer/HyperVGraphicsFramebufferPublication.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..03cf2ef991bf52ba158c158b7c83658745050583
--- /dev/null
+++ b/MacHyperVFramebuffer/HyperVGraphicsFramebufferPublication.cpp
@@ -0,0 +1,269 @@
+#include "HyperVGraphicsFramebuffer.hpp"
+#include <IOKit/IOUserClient.h>
+IOReturn HyperVGraphicsFramebuffer::publicationCursorClassification(HPControlKind kind,UInt64 serial,UInt64 epoch) {
+  HPControl request={};HPReply reply={};
+  request.header={sizeof(request),HP_ABI_VERSION};request.kind=kind;
+  request.framebufferIdentity=getRegistryEntryID();request.expectedEpoch=epoch;
+  request.objectIdentity=serial;
+  IOService *provider=retainPublicationProvider();if (!provider) return kIOReturnNotReady;
+  const IOReturn result=provider->callPlatformFunction(_publicationControlSymbol,false,&request,
+      reinterpret_cast<void *>(sizeof(request)),&reply,reinterpret_cast<void *>(sizeof(reply)));
+  provider->release();
+  if(kind==HPControlKind::CursorUnclassified) noteWSAA(WSCursorUnclassified,serial,result);
+  else if(kind==HPControlKind::CursorCapabilitiesRecorded) noteWSAA(WSCursorCapabilities,serial,result);
+  return result;
+}
+bool HyperVGraphicsFramebuffer::setProperty(const char *key,OSObject *value) {
+  if (!key || strcmp(key,kIOFBCursorInfoKey)) return super::setProperty(key,value);
+  lockForArbitration();
+  const UInt64 pendingSerial=_cursorUnclassifiedSerial,pendingEpoch=_cursorUnclassifiedEpoch;
+  OSObject *oldInfo=_cursorInfoBeforeFailure;
+  if (oldInfo) oldInfo->retain();
+  unlockForArbitration();
+  const bool result=super::setProperty(key,value);
+  lockForArbitration();
+  const bool eligible=result && pendingSerial &&
+      pendingSerial==_cursorUnclassifiedSerial && pendingEpoch==_cursorUnclassifiedEpoch &&
+      pendingEpoch==publicationEpoch() && value!=oldInfo;
+  unlockForArbitration();
+  OSSafeReleaseNULL(oldInfo);
+  if (!eligible) return result;
+  OSArray *array=OSDynamicCast(OSArray,value);
+  if (!array || !array->getCount() || array->getCount()>16) return result;
+  unsigned matching=0;
+  for (unsigned i=0;i<array->getCount();++i) {
+    OSData *data=OSDynamicCast(OSData,array->getObject(i));
+    if (!data || data->getLength()!=sizeof(IOHardwareCursorDescriptor)) continue;
+    IOHardwareCursorDescriptor d={};bcopy(data->getBytesNoCopy(),&d,sizeof(d));
+    bool encodings=true;
+    for (unsigned index=0;index<16;++index)
+      if (d.specialEncodings[index]!=(index==kInvertingEncoding?0x00ffffffu:0u)) encodings=false;
+    if (d.majorVersion==kHardwareCursorDescriptorMajorVersion && d.minorVersion==kHardwareCursorDescriptorMinorVersion &&
+        d.width==512 && d.height==512 && d.bitDepth==32 && !d.colorEncodings &&
+        !d.maskBitDepth && !d.numColors && !d.flags && encodings && d.supportedSpecialEncodings==kInvertingEncodedPixel)
+      ++matching;
+  }
+  // Pinned IOGraphics postOpen/processConnectChange publish their newly built
+  // capability array immediately after the testing calls, under family gates.
+  // This is public descriptor evidence; neither cursorImage==0 nor a private
+  // testingCursor field/offset is used. Unmatched/older failures stay latched.
+  lockForArbitration();
+  const bool current=pendingSerial==_cursorUnclassifiedSerial && pendingEpoch==_cursorUnclassifiedEpoch && pendingEpoch==publicationEpoch();
+  unlockForArbitration();
+  if (matching==1 && current && publicationCursorClassification(HPControlKind::CursorCapabilitiesRecorded,
+      pendingSerial,pendingEpoch)==kIOReturnSuccess) {
+    OSObject *retired=nullptr;
+    lockForArbitration();
+    if (pendingSerial==_cursorUnclassifiedSerial && pendingEpoch==_cursorUnclassifiedEpoch) {
+      _cursorUnclassifiedSerial=0;retired=_cursorInfoBeforeFailure;_cursorInfoBeforeFailure=nullptr;
+    }
+    unlockForArbitration();
+    OSSafeReleaseNULL(retired);
+  }
+  return result;
+}
+IOService *HyperVGraphicsFramebuffer::retainPublicationProvider() {
+  lockForArbitration();
+  IOService *provider=__atomic_load_n(&_publicationAttached,__ATOMIC_ACQUIRE)?_hvGfxProvider:nullptr;
+  if (provider) provider->retain();
+  unlockForArbitration();
+  return provider;
+}
+
+IOReturn HyperVGraphicsFramebuffer::publicationControlImpl(HPControlKind kind,UInt32 value,UInt32 width,UInt32 height) {
+  if (!publicationAttached()) return kIOReturnNotReady;
+  HPControl request={};HPReply reply={};
+  request.header={sizeof(request),HP_ABI_VERSION};request.kind=kind;request.value=value;
+  request.framebufferIdentity=getRegistryEntryID();request.expectedEpoch=publicationEpoch();
+  request.width=width;request.height=height;
+  IOService *provider=retainPublicationProvider();
+  if (!provider) return kIOReturnNotReady;
+  IOReturn result=provider->callPlatformFunction(_publicationControlSymbol,false,&request,
+      reinterpret_cast<void *>(sizeof(request)),&reply,reinterpret_cast<void *>(sizeof(reply)));
+  provider->release();
+  if (reply.header.bytes==sizeof(reply) && reply.header.version==HP_ABI_VERSION && reply.ticket.epoch)
+    __atomic_store_n(&_publicationEpoch,reply.ticket.epoch,__ATOMIC_RELEASE);
+  setProperty("HyperVPublicationEpoch",publicationEpoch(),64);
+  if (kind==HPControlKind::Detach && result==kIOReturnSuccess) __atomic_store_n(&_publicationAttached,false,__ATOMIC_RELEASE);
+  return result;
+}
+IOReturn HyperVGraphicsFramebuffer::publicationBind(IOService *accelerator) {
+  if (!publicationAttached() || !accelerator || accelerator->getProvider()!=getProvider() ||
+      strcmp(accelerator->getMetaClass()->getClassName(),"NVAccel")!=0) return kIOReturnBadArgument;
+  const UInt64 identity=accelerator->getRegistryEntryID();
+  if (publicationAcceleratorIdentity() && publicationAcceleratorIdentity()!=identity) return kIOReturnExclusiveAccess;
+  HPControl request={};HPReply reply={};
+  request.header={sizeof(request),HP_ABI_VERSION};request.kind=HPControlKind::BindAccelerator;
+  request.framebufferIdentity=getRegistryEntryID();request.expectedEpoch=publicationEpoch();
+  request.objectIdentity=identity;
+  IOService *provider=retainPublicationProvider();
+  if (!provider) return kIOReturnNotReady;
+  IOReturn result=provider->callPlatformFunction(_publicationControlSymbol,false,&request,
+      reinterpret_cast<void *>(sizeof(request)),&reply,reinterpret_cast<void *>(sizeof(reply)));
+  provider->release();
+  if (result==kIOReturnSuccess) __atomic_store_n(&_publicationAccelerator,identity,__ATOMIC_RELEASE);
+  return result;
+}
+IODeviceMemory *HyperVGraphicsFramebuffer::getVRAMRange() {
+  if (!_scanoutMemory) return nullptr;
+  return _scanoutMemory->copyIODeviceMemory(); // Same B, +1 legacy factory facade.
+}
+IOReturn HyperVGraphicsFramebuffer::publicationSetupForCurrentConfig() {
+  // doSetup(true) maps the public backing before returning here. A successful
+  // family return alone is insufficient: doSetup also returns success when no
+  // aperture/map was obtained. Keep publication closed unless the map fits.
+  const IOReturn result=super::setupForCurrentConfig();
+  if (publicationAttached()) {
+    const bool established=result==kIOReturnSuccess && fVramMap && validDisplayMode(_currentDisplayMode) &&
+        fVramMap->getLength()>=uint64_t(_gfxModes[_currentDisplayMode-1].width)*_gfxModes[_currentDisplayMode-1].height*4;
+    const IOReturn status=publicationControl(HPControlKind::SetupResult,established);
+    if (result==kIOReturnSuccess && (!established || status!=kIOReturnSuccess))
+      return established?status:kIOReturnNotReady;
+  }
+  return result;
+}
+IOReturn HyperVGraphicsFramebuffer::publicationSetAttribute(IOSelect attribute,uintptr_t value) {
+  if (attribute==kIOWindowServerActiveAttribute) {
+    if (!publicationAttached()) return kIOReturnNotReady;
+    switch (value&kIOWSAA_StateMask) {
+    case kIOWSAA_Accelerated:
+      return publicationControl(HPControlKind::Accelerated);
+    case kIOWSAA_Unaccelerated:
+    case kIOWSAA_DriverOpen:
+      return publicationControl(HPControlKind::ToLegacy);
+    case kIOWSAA_From_Accelerated:
+    case kIOWSAA_To_Accelerated:
+    case kIOWSAA_Sleep:
+      return publicationControl(HPControlKind::Defer);
+    default:return kIOReturnBadArgument;
+    }
+  }
+  // Close ownership before power/stop callbacks. These existing attributes do
+  // not establish GPU ownership again; setup+active WSAA+fresh S are required.
+  if (publicationAttached() && (attribute==kIOSystemPowerAttribute || attribute==kIOFBStop))
+    publicationControl(HPControlKind::Defer);
+  return super::setAttribute(attribute,value);
+}
+IOReturn HyperVGraphicsFramebuffer::publicationOpen() {
+  if (publicationAttached()) {
+    // Opening establishes DriverOpen. Initial public backing mapping may occur
+    // only after the server userclient opens and requests current-mode setup.
+    publicationControl(HPControlKind::SetupResult,0);
+    publicationControl(HPControlKind::ToLegacy);
+  }
+  const IOReturn result=super::open();
+  // postOpen -> initFB returns immediately when fFrameBuffer is initially null;
+  // it does not guarantee fVramMap. Rejecting that successful open prevents the
+  // userclient whose later setup creates the map. Only setupForCurrentConfig
+  // may establish publication; never synthesize setup or accelerated WSAA here.
+  if (result!=kIOReturnSuccess && publicationAttached())
+    publicationControl(HPControlKind::SetupResult,0);
+  return result;
+}
+void HyperVGraphicsFramebuffer::publicationClose() {
+  if (publicationAttached()) publicationControl(HPControlKind::ToLegacy);
+  super::close();
+}
+
+// BEGIN WSAA_DIAGNOSTICS
+void HyperVGraphicsFramebuffer::noteWSAA(WSAADiagnosticEvent event,UInt64 value,IOReturn status,bool valueValid) {
+  if (event>=WSEventCount) return;
+  // This lock protects only copied scalar records. Never hold it across family,
+  // publication-provider, registry or memory allocation calls.
+  lockForArbitration();
+  auto &r=_wsaaDiagnostics[event];
+  if (_wsaaDiagnosticSequence!=UINT64_MAX) ++_wsaaDiagnosticSequence; else _wsaaDiagnosticOverflow=true;
+  if (r.count!=UINT64_MAX) ++r.count; else _wsaaDiagnosticOverflow=true;
+  if (status==kIOReturnSuccess) {
+    if (r.successes!=UINT64_MAX) ++r.successes; else _wsaaDiagnosticOverflow=true;
+  }
+  r.sequence=_wsaaDiagnosticSequence;r.value=value;r.status=static_cast<UInt32>(status);
+  r.epoch=publicationEpoch();r.valueValid=valueValid?1:0;
+  unlockForArbitration();
+}
+IOReturn HyperVGraphicsFramebuffer::setAttribute(IOSelect attribute,uintptr_t value) {
+  const IOReturn result=publicationSetAttribute(attribute,value);
+  if (attribute==kIOWindowServerActiveAttribute) {
+    noteWSAA(WSSet,value,result);
+    WSAADiagnosticEvent event=WSOther;
+    switch(value&kIOWSAA_StateMask) {
+    case kIOWSAA_Accelerated:event=WSAccelerated;break;
+    case kIOWSAA_Unaccelerated:event=WSUnaccelerated;break;
+    case kIOWSAA_From_Accelerated:event=WSFrom;break;
+    case kIOWSAA_To_Accelerated:event=WSTo;break;
+    case kIOWSAA_Sleep:event=WSSleep;break;
+    }
+    noteWSAA(event,value,result);
+  }
+  return result;
+}
+IOReturn HyperVGraphicsFramebuffer::open() {
+  const IOReturn result=publicationOpen();noteWSAA(WSOpen,0,result,false);return result;
+}
+void HyperVGraphicsFramebuffer::close() {
+  publicationClose();noteWSAA(WSClose,0,kIOReturnSuccess,false);
+}
+IOReturn HyperVGraphicsFramebuffer::setupForCurrentConfig() {
+  const IOReturn result=publicationSetupForCurrentConfig();noteWSAA(WSSetup,0,result,false);return result;
+}
+IOReturn HyperVGraphicsFramebuffer::publicationControl(HPControlKind kind,UInt32 value,UInt32 width,UInt32 height) {
+  const IOReturn result=publicationControlImpl(kind,value,width,height);
+  WSAADiagnosticEvent event=WSEventCount;
+  switch(kind) {
+  case HPControlKind::ModeBegin:event=WSModeBegin;break;
+  case HPControlKind::ModeFinish:event=WSModeFinish;break;
+  case HPControlKind::SetupResult:event=WSSetupResult;break;
+  case HPControlKind::Accelerated:event=WSControlAccelerated;break;
+  case HPControlKind::ToLegacy:event=WSToLegacy;break;
+  case HPControlKind::Defer:event=WSDefer;break;
+  case HPControlKind::CursorInvalid:event=WSCursorInvalid;break;
+  case HPControlKind::Detach:event=WSDetach;break;
+  default:break;
+  }
+  if (event!=WSEventCount) noteWSAA(event,kind==HPControlKind::ModeFinish?(UInt64(width)<<32)|height:value,result);
+  return result;
+}
+static bool wsaaNumber(OSDictionary *d,const char *key,UInt64 value) {
+  OSNumber *n=OSNumber::withNumber(value,64);if(!n)return false;
+  const bool ok=d->setObject(key,n);n->release();return ok;
+}
+IOReturn HyperVGraphicsFramebuffer::snapshotWSAA(UInt64 requestId) {
+  WSAADiagnosticRecord records[WSEventCount];UInt64 sequence,generation;bool overflow;
+  lockForArbitration();
+  if (_wsaaDiagnosticGeneration==UINT64_MAX) {unlockForArbitration();return kIOReturnNoResources;}
+  generation=++_wsaaDiagnosticGeneration;sequence=_wsaaDiagnosticSequence;overflow=_wsaaDiagnosticOverflow;
+  for(unsigned i=0;i<WSEventCount;++i) records[i]=_wsaaDiagnostics[i];
+  unlockForArbitration();
+  static const char *names[WSEventCount]={"GetWSRV","SetWSRV","Open","Close","Setup",
+    "SetAccelerated","SetUnaccelerated","SetFromAccelerated","SetToAccelerated","SetSleep","SetOther",
+    "ModeBegin","ModeFinish","SetupResult","ControlAccelerated","ToLegacy","Defer",
+    "CursorInvalid","CursorUnclassified","CursorCapabilities","Detach"};
+  OSDictionary *d=OSDictionary::withCapacity(6),*events=OSDictionary::withCapacity(WSEventCount);
+  bool ok=d&&events;
+  if(ok) ok=wsaaNumber(d,"Version",1)&&wsaaNumber(d,"RequestId",requestId)&&
+      wsaaNumber(d,"Generation",generation)&&wsaaNumber(d,"Sequence",sequence)&&wsaaNumber(d,"Overflow",overflow?1:0);
+  for(unsigned i=0;ok&&i<WSEventCount;++i) {
+    OSDictionary *e=OSDictionary::withCapacity(7);if(!e){ok=false;break;}
+    const auto &v=records[i];
+    ok=wsaaNumber(e,"Count",v.count)&&wsaaNumber(e,"Successes",v.successes)&&wsaaNumber(e,"Sequence",v.sequence)&&
+       wsaaNumber(e,"Value",v.value)&&wsaaNumber(e,"Status",v.status)&&wsaaNumber(e,"Epoch",v.epoch)&&
+       wsaaNumber(e,"ValueValid",v.valueValid)&&events->setObject(names[i],e);
+    e->release();
+  }
+  if(ok) ok=d->setObject("Events",events);
+  // Publish exactly one complete immutable response. Allocation/publication
+  // failure leaves the old property; callers must check the fresh RequestId.
+  if(ok) ok=super::setProperty("HyperVWSAADiagnostics",d);
+  OSSafeReleaseNULL(events);OSSafeReleaseNULL(d);
+  return ok?kIOReturnSuccess:kIOReturnNoMemory;
+}
+IOReturn HyperVGraphicsFramebuffer::setProperties(OSObject *properties) {
+  OSDictionary *d=OSDynamicCast(OSDictionary,properties);
+  if(!d || !d->getObject("HyperVWSAADiagnosticSnapshot")) return super::setProperties(properties);
+  OSNumber *request=OSDynamicCast(OSNumber,d->getObject("HyperVWSAADiagnosticSnapshot"));
+  if(d->getCount()!=1 || !request || !request->unsigned64BitValue()) return kIOReturnBadArgument;
+  if(IOUserClient::clientHasPrivilege(current_task(),kIOClientPrivilegeAdministrator)!=kIOReturnSuccess)
+    return kIOReturnNotPrivileged;
+  return snapshotWSAA(request->unsigned64BitValue());
+}
