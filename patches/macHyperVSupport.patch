+void HyperVGraphics::queueFeatureWork(UInt32 flags) {
+  // Called under the VMBus receive gate. Only atomic publication and a timer
+  // wakeup are allowed here; sending graphics messages would invert gate order.
+  if (__atomic_load_n(&_stopping, __ATOMIC_ACQUIRE) || !_fbReady || !_featureEventSource) return;
+  __sync_add_and_fetch(&_featureRequestsReceived, 1);
+  const UInt32 previous = __sync_fetch_and_or(&_pendingFeatures, flags | kFeatureRefreshPending);
+  // Coalesced requests also must not invalidate an already scheduled callout.
+  if (!previous) _featureEventSource->setTimeoutMS(0);
