+IOReturn HyperVGraphicsFramebuffer::callPlatformFunction(const OSSymbol *functionName, bool waitForFunction,
+                                                        void *param1, void *param2, void *param3, void *param4) {
+  if (functionName && functionName->isEqualTo("HyperVPublicationBindV1"))
+    return publicationBind(OSDynamicCast(IOService, static_cast<OSObject *>(param1)));
+  if (functionName && (functionName->isEqualTo(HP_FN_DESCRIBE) || functionName->isEqualTo(HP_FN_COMMIT))) {
+    if (!publicationAttached() || !publicationAcceleratorIdentity() || !param1 || !param3 ||
+        reinterpret_cast<uintptr_t>(param4) != sizeof(HPReply)) return kIOReturnNotReady;
+    HPRoutedCall call = {};
+    call.header = {sizeof(call), HP_ABI_VERSION};
+    call.framebufferIdentity = getRegistryEntryID(); call.producerIdentity = publicationAcceleratorIdentity();
+    call.operation = functionName->isEqualTo(HP_FN_DESCRIBE) ? HPOperation::Describe : HPOperation::Commit;
+    call.input = param1; call.inputBytes = reinterpret_cast<uintptr_t>(param2);
+    call.reply = static_cast<HPReply *>(param3);
+    IOService *provider=retainPublicationProvider();
+    if (!provider) return kIOReturnNotReady;
+    IOReturn result=provider->callPlatformFunction(_publicationRoutedSymbol, false, &call,
+        reinterpret_cast<void *>(sizeof(call)), nullptr, nullptr);
+    provider->release();return result;
+  }
+  if (functionName && functionName->isEqualTo(HP_FN_CPU_FRAME)) {
+    if (!publicationAttached() || !publicationAcceleratorIdentity()) return kIOReturnNotReady;
+    IOService *provider=retainPublicationProvider();
+    if (!provider) return kIOReturnNotReady;
+    IOReturn result=provider->callPlatformFunction(_publicationCPUSymbol, false, param1, param2, param3, param4);
+    provider->release();return result;
+  }
+  if (functionName && (functionName->isEqualTo(kHyperVGraphicsPlatformFunctionDmaTestPage) ||
+      functionName->isEqualTo(kHyperVGraphicsPlatformFunctionPresent) ||
+      functionName->isEqualTo(NVRM_VRAM_FN_SCANOUT))) return kIOReturnUnsupported;
+  if (functionName && functionName->isEqualTo("HyperVConsoleAgdcTiming")) {
+    if (!param1 || reinterpret_cast<uintptr_t>(param2) != 13 * sizeof(UInt32)) return kIOReturnBadArgument;
+    if (!validDisplayMode(_currentDisplayMode)) return kIOReturnNotReady;
+    const HyperVGraphicsMode &mode = _gfxModes[_currentDisplayMode - 1];
+    // Match the compositor's link timing to the selected virtual mode.
+    UInt32 timing[13] = {0x4b350001U, (mode.width + 160) * (mode.height + 32) * mode.refreshHz,
+      mode.width, mode.width + 48, mode.width + 80, mode.width + 160,
+      mode.height, mode.height + 3, mode.height + 6, mode.height + 32, mode.refreshHz * 1000, 1, 0};
+    memcpy(param1, timing, sizeof(timing));
+    return kIOReturnSuccess;
+  }
+  return super::callPlatformFunction(functionName, waitForFunction, param1, param2, param3, param4);
+}
