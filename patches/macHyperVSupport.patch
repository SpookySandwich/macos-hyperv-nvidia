+IOReturn HyperVGraphicsFramebuffer::enableController() {
+  if (!_scanoutMap) return kIOReturnNotReady;
+  OSIterator *children = getProvider()->getChildIterator(gIOServicePlane);
+  if (children) {
+    while (OSObject *child = children->getNextObject()) {
+      IOService *service = OSDynamicCast(IOService, child);
+      if (service && strcmp(service->getMetaClass()->getClassName(), "NVAccel") == 0) {
+        if (publicationBind(service) != kIOReturnSuccess) continue;
+        IOReturn result = service->callPlatformFunction("nvRegisterConsoleFramebuffer", false,
+                                                       this, nullptr, nullptr, nullptr);
+        setProperty("HyperVConsoleRegistrationStatus", static_cast<UInt32>(result), 32);
+        HVSYSLOG("NVIDIA console registration returned 0x%X", result);
+      }
+    }
+    children->release();
+  }
+  return kIOReturnSuccess;
+}
