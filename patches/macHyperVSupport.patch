+bool HyperVGraphics::initializeEventSources() {
+  _workLoop = IOWorkLoop::workLoop();
+  if (!_workLoop) return false;
+  _cmdGate = IOCommandGate::commandGate(this);
+  if (!_cmdGate || _workLoop->addEventSource(_cmdGate) != kIOReturnSuccess) return false;
+  _commandGateAdded = true;
+  _timerEventSource = IOTimerEventSource::timerEventSource(this,
+      OSMemberFunctionCast(IOTimerEventSource::Action, this, &HyperVGraphics::handleRefreshTimer));
+  if (!_timerEventSource || _workLoop->addEventSource(_timerEventSource) != kIOReturnSuccess) return false;
+  _refreshTimerAdded = true;
+  // Feature deadlines belong to this source alone. Present/idle refresh may
+  // rearm the heartbeat source without invalidating a queued feature callout.
+  _featureEventSource = IOTimerEventSource::timerEventSource(this,
+      OSMemberFunctionCast(IOTimerEventSource::Action, this, &HyperVGraphics::handleFeatureTimer));
+  if (!_featureEventSource || _workLoop->addEventSource(_featureEventSource) != kIOReturnSuccess) return false;
+  _featureTimerAdded = true;
+  setProperty("HyperVFeatureWorkScheduler", "Dedicated timer");
+  return true;
+}
+
+IOReturn HyperVGraphics::quiesceEventSourcesGated() {
+  _fbReady = false;
+  _imageProbeBudget = 0;
+  _imageRectBudget = 0;
+  _imageRectRestoreFull = false;
+  if (_featureEventSource) {
+    _featureEventSource->disable();
+    _featureEventSource->cancelTimeout();
+  }
+  if (_timerEventSource) {
+    _timerEventSource->disable();
+    _timerEventSource->cancelTimeout();
+  }
+  __sync_lock_test_and_set(&_pendingFeatures, 0);
+  publicationDetachGated();
+  return kIOReturnSuccess;
+}
+
+void HyperVGraphics::releaseEventSources() {
+  // setProperties holds the same public IOService lock through runAction.
+  // No graphics/receive action takes this lock. Receive is already detached.
+  // This keeps the gate attached/alive for a control request racing stop().
+  lockForArbitration();
+  // stop() has detached receive callbacks without holding the graphics gate.
+  // Use the public command-gate API to serialize with active timer/actions;
+  // IOWorkLoop's closeGate/openGate are protected implementation details.
+  if (_commandGateAdded) {
+    _cmdGate->runAction(OSMemberFunctionCast(IOCommandGate::Action, this,
+        &HyperVGraphics::quiesceEventSourcesGated));
+  } else {
+    // Initialization attaches the command gate before creating either timer.
+    // With no attached gate there can be no graphics callbacks to quiesce.
+    quiesceEventSourcesGated();
+  }
+  // Disabled/cancelled timers cannot start new actions. Public removal handles
+  // its own work-loop locking; release the command gate only after its action.
+  if (_featureEventSource) {
+    if (_featureTimerAdded) _workLoop->removeEventSource(_featureEventSource);
+    OSSafeReleaseNULL(_featureEventSource);
+  }
+  _featureTimerAdded = false;
+  if (_timerEventSource) {
+    if (_refreshTimerAdded) _workLoop->removeEventSource(_timerEventSource);
+    OSSafeReleaseNULL(_timerEventSource);
+  }
+  _refreshTimerAdded = false;
+  if (_cmdGate) {
+    if (_commandGateAdded) _workLoop->removeEventSource(_cmdGate);
+    OSSafeReleaseNULL(_cmdGate);
+  }
+  _commandGateAdded = false;
+  OSSafeReleaseNULL(_workLoop);
+  unlockForArbitration();
+}
+
+IOReturn HyperVGraphics::setProperties(OSObject *properties) {
+  OSDictionary *dictionary = OSDynamicCast(OSDictionary, properties);
+  if (!dictionary) return kIOReturnBadArgument;
+  if (!dictionary->getObject("HyperVImageUpdateProbeBudget") &&
+      !dictionary->getObject("HyperVImageUpdateProbeSnapshot") &&
+      !dictionary->getObject("HyperVImageRectProbeControl") &&
+      !dictionary->getObject("HyperVImageRectProbeSnapshot") &&
+      !dictionary->getObject("HyperVPublicationSnapshot"))
+    return super::setProperties(properties);
+  if (IOUserClient::clientHasPrivilege(current_task(), kIOClientPrivilegeAdministrator) != kIOReturnSuccess)
+    return kIOReturnNotPrivileged;
+  if (!lockForArbitration(false)) return kIOReturnNotReady;
+  IOReturn result = kIOReturnNotReady;
+  if (!__atomic_load_n(&_stopping, __ATOMIC_ACQUIRE) && _commandGateAdded) {
+    result = _cmdGate->runAction(OSMemberFunctionCast(IOCommandGate::Action, this,
+        &HyperVGraphics::controlImageUpdateProbeGated), dictionary);
+  }
+  unlockForArbitration();
+  return result;
+}
+
+IOReturn HyperVGraphics::controlImageUpdateProbeGated(OSDictionary *properties) {
+  if (properties->getObject("HyperVPublicationSnapshot")) {
+    OSNumber *request=OSDynamicCast(OSNumber,properties->getObject("HyperVPublicationSnapshot"));
+    if (properties->getCount()!=1 || !request || !request->unsigned64BitValue())
+      return kIOReturnBadArgument;
+    return publicationSnapshotGated(request->unsigned64BitValue());
+  }
+  if (_publisher) return kIOReturnUnsupported; // Owner debt must not be suppressed/overridden.
+  if (__atomic_load_n(&_stopping, __ATOMIC_ACQUIRE)) return kIOReturnNotReady;
+  // Exactly one command, with its exact type. In particular, negative CFNumbers
+  // become large unsigned values and cannot bypass the finite budget limit.
+  if (properties->getCount() != 1) return kIOReturnBadArgument;
+  if (properties->getObject("HyperVImageRectProbeControl") ||
+      properties->getObject("HyperVImageRectProbeSnapshot"))
+    return controlImageRectProbeGated(properties);
+  OSObject *budgetObject = properties->getObject("HyperVImageUpdateProbeBudget");
+  if (budgetObject) {
+    OSNumber *budget = OSDynamicCast(OSNumber, budgetObject);
+    if (!budget || budget->unsigned64BitValue() > kImageProbeMaxBudget)
+      return kIOReturnBadArgument;
+    const UInt32 value = static_cast<UInt32>(budget->unsigned64BitValue());
+    if (value && !_fbReady) return kIOReturnNotReady;
+    // Never combine suppression and rectangle interventions, or suppress the
+    // full repair notification after a rectangle experiment.
+    if (value && (_imageRectBudget || _imageRectRestoreFull)) return kIOReturnBusy;
+    _imageProbeBudget = _imageProbeInitialBudget = value;
+    ++_imageProbeGeneration;
+    if (!publishImageUpdateProbeGated()) {
+      // An unsuccessful arm must never leave suppression enabled. Cancelling
+      // also remains effective when a snapshot cannot be allocated/published.
+      _imageProbeBudget = 0;
+      return kIOReturnNoMemory;
+    }
+    return kIOReturnSuccess;
+  }
+  if (properties->getObject("HyperVImageUpdateProbeSnapshot") != kOSBooleanTrue)
+    return kIOReturnBadArgument;
+  return publishImageUpdateProbeGated() ? kIOReturnSuccess : kIOReturnNoMemory;
+}
+
+bool HyperVGraphics::publishImageUpdateProbeGated() {
+  // On-demand only: never allocate a dictionary or number in the frame path.
+  // One immutable dictionary replaces the previous snapshot atomically.
+  const UInt32 host = __atomic_load_n(&_hostFeatureState, __ATOMIC_ACQUIRE);
+  const char *keys[] = { "Version", "MaxBudget", "Generation", "InitialBudget",
+      "Remaining", "Accepted", "ArmedAccepted", "Suppressed", "Enqueued",
+      "SendFailed", "HostKnown", "HostFlags", "HostImageNeeded" };
+  const UInt64 values[] = { 1, kImageProbeMaxBudget, _imageProbeGeneration,
+      _imageProbeInitialBudget, _imageProbeBudget, _imageProbeAccepted,
+      _imageProbeArmedAccepted, _imageProbeSuppressed, _imageProbeEnqueued,
+      _imageProbeSendFailed, (host & kImageProbeHostKnown) ? 1ull : 0ull,
+      host & 15u, (host & 1u) ? 1ull : 0ull };
+  const unsigned count = sizeof(keys) / sizeof(keys[0]);
+  OSDictionary *snapshot = OSDictionary::withCapacity(count);
+  if (!snapshot) return false;
+  bool ok = true;
+  for (unsigned i = 0; i < count && ok; ++i) {
+    OSNumber *number = OSNumber::withNumber(values[i], 64);
+    ok = number && snapshot->setObject(keys[i], number);
+    OSSafeReleaseNULL(number);
+  }
+  if (ok) ok = setProperty("HyperVImageUpdateProbe", snapshot);
+  snapshot->release();
+  return ok;
+}
+
+IOReturn HyperVGraphics::controlImageRectProbeGated(OSDictionary *properties) {
+  // The outer single-command check, privilege/lifetime check and graphics gate
+  // are shared with the existing image-needed probe control.
+  OSObject *controlObject = properties->getObject("HyperVImageRectProbeControl");
