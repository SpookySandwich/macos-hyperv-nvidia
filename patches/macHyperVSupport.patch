+IORangeScalar HyperVPCIRoot::allocateFramebufferRange(IORangeScalar size) {
+  if (!canAllocateMMIO || !_framebufferLock || !size || size > kHyperVGraphicsMaxApertureBytes) return 0;
+  IOLockLock(_framebufferLock);
