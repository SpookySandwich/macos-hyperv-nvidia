+static bool hp_span(uint64_t p,uint64_t n) { return p && n && n-1<=UINTPTR_MAX-p; }
+static bool hp_same_epoch(HPTicket a,PCTicket b) {
+  return a.output==b.output && a.epoch==b.epoch && a.ownerGeneration==b.owner_generation && a.producerToken==b.producer_token;
