diff --git a/publication/HyperVCompletedFrameAbi.hpp b/publication/HyperVCompletedFrameAbi.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..89a9c2e03d04bc977e8cf31c8ec781428ae84fad
--- /dev/null
+++ b/publication/HyperVCompletedFrameAbi.hpp
@@ -0,0 +1,68 @@
+#ifndef HYPERV_COMPLETED_FRAME_ABI_HPP
+#define HYPERV_COMPLETED_FRAME_ABI_HPP
+#include <stddef.h>
+#include <stdint.h>
+
+/* NEW driver-owned, synchronous trusted-kernel contract. These names are not
+ * existing Apple/IOAccel private APIs. No user pointers, async leases or raw A
+ * addresses are returned. Version1 is x86_64 only; policy is reported in flags.
+ * Source remains a full immutable frame; no caller damage/actual-A request. */
+#define HP_FN_DESCRIBE "HyperVPublicationDescribeV1"
+#define HP_FN_ACQUIRE "HyperVPublicationAcquireV1"
+#define HP_FN_COMMIT "HyperVPublicationCommitCompletedV1"
+#define HP_FN_REVOKE "HyperVPublicationRevokeV1"
+enum { HP_ABI_VERSION=1, HP_FORMAT_BGRA8888=1 };
+enum class HPOperation : uint32_t { Describe=1, Acquire=2, Commit=3, Revoke=4 };
+enum class HPStatus : uint32_t { Ok=0, BadBuffer, BadVersion, BadRequest, WrongRoute, CoreRejected };
+enum : uint32_t {
+    HP_REPLY_FULL_ONLY=1, HP_REPLY_READY=2, HP_REPLY_PIXELS_ESTABLISHED=4,
+    HP_REPLY_NOTIFY_ATTEMPTED=8, HP_REPLY_QUEUED=16, HP_REPLY_DEBT=32,
+    HP_REPLY_EXACT_ROWS=64 /* Accelerated policy capability, not this frame's damage. */
+};
+enum : uint32_t { HP_LEASE_COMPLETED_CACHED_IMMUTABLE=1 };
+enum : uint32_t { HP_COMMIT_VERIFY_COMPOSED=1, HP_COMMIT_SAMPLE_WORDS=2, HP_MAX_SAMPLE_WORDS=40 };
+struct HPHeader { uint32_t bytes, version; };
+struct HPTicket { uint64_t output, epoch, ownerGeneration, producerToken; };
+struct HPGeometry {
+    uint32_t width,height,format,reserved;
+    uint64_t aperturePitch,apertureLength;
+};
+struct HPCompletedLease {
+    uint64_t cpuAddress,validLength,pitch,leaseIdentity,sourceIdentity;
+    uint32_t flags,reserved;
+};
+struct HPDescribe { HPHeader header; uint64_t expectedOutput; };
+struct HPAcquire { HPHeader header; HPTicket expected; uint32_t owner,reserved; };
+struct HPRevoke { HPHeader header; HPTicket ticket; };
+struct HPSampleRequest { uint64_t firstByte; uint32_t strideBytes,count; };
+struct HPCommit {
+    HPHeader header;
+    uint32_t flags,reserved; /* Only bounded VERIFY_COMPOSED. No partial/D API. */
+    HPTicket ticket;
+    uint64_t serial;
+    HPGeometry geometry;
+    HPCompletedLease source;
+    HPSampleRequest sample; /* Diagnostic only; bounded visible-A words. */
+};
+struct HPVerification {
+    uint64_t comparedWords,badWords,firstByte;
+    uint32_t expected,actual,minX,minY,maxX,maxY;
+    uint32_t attempted,complete;
+};
+struct HPWordSamples { uint32_t attempted,count; uint32_t words[HP_MAX_SAMPLE_WORDS]; };
+struct HPReply {
+    HPHeader header;
+    HPStatus status;
+    uint32_t coreStatus,flags,reserved;
+    HPTicket ticket;
+    HPGeometry geometry;
+    uint64_t acceptedSerial;
+    HPVerification verification;
+    HPWordSamples samples;
+};
+static_assert(sizeof(uintptr_t)==8,"completed-frame ABI requires qualified x86_64 kernel");
+static_assert(sizeof(HPTicket)==32 && sizeof(HPGeometry)==32 && sizeof(HPCompletedLease)==48,"ABI layout");
+static_assert(sizeof(HPDescribe)==16 && sizeof(HPAcquire)==48 && sizeof(HPRevoke)==40,"ABI requests");
+static_assert(sizeof(HPCommit)==152 && sizeof(HPReply)==320 && sizeof(HPVerification)==56,"ABI commit/result");
+static_assert(offsetof(HPCommit,source)==88 && offsetof(HPReply,geometry)==56,"ABI offsets");
+#endif
diff --git a/publication/HyperVPublicationKernelMemory.cpp b/publication/HyperVPublicationKernelMemory.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..016b0ef88fb2e188409c9e2e58bb22fa152c71eb
--- /dev/null
+++ b/publication/HyperVPublicationKernelMemory.cpp
@@ -0,0 +1,13 @@
+#include "PublicationAdapters.hpp"
+#include <libkern/libkern.h>
+static int compare_cached(const unsigned char *a,const unsigned char *b,size_t n,void *) {
+    return bcmp(a,b,n);
+}
+static void copy_cached(void *,unsigned char *dst,const unsigned char *src,size_t n) {
+    bcopy(src,dst,n);
+}
+void hp_use_qualified_kernel_memory(PCOps *ops) {
+    if(!ops)return;
+    ops->compare=compare_cached;ops->compare_context=nullptr;
+    ops->copy_reference=copy_cached;ops->copy_context=nullptr;
+}
diff --git a/publication/HyperVPublicationLifecycle.hpp b/publication/HyperVPublicationLifecycle.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..a1224f13d59bb00e298ff57f61635042c5a8ac97
--- /dev/null
+++ b/publication/HyperVPublicationLifecycle.hpp
@@ -0,0 +1,46 @@
+#ifndef HYPERV_PUBLICATION_LIFECYCLE_HPP
+#define HYPERV_PUBLICATION_LIFECYCLE_HPP
+#include "HyperVCompletedFrameAbi.hpp"
+/* Driver-owned synchronous kernel-only ABI. All pointers are borrowed until
+ * return. Attach retains the supplied precreated B mapping, never the FB.
+ * Neither Describe nor any other request exposes the physical aperture A. */
+#define HP_FN_CONTROL "HyperVPublicationControlV1"
+#define HP_FN_ROUTED "HyperVPublicationRoutedV1"
+#define HP_FN_CPU_FRAME "HyperVPublicationCPUFrameV1"
+enum class HPControlKind : uint32_t {
+    Attach=1, Detach, BindAccelerator, ModeBegin, ModeFinish, SetupResult,
+    Accelerated, ToLegacy, Defer, CursorInvalid, CursorShape, CursorPosition,
+    CursorRefresh, CursorUnclassified, CursorCapabilitiesRecorded
+};
+struct HPControl {
+    HPHeader header;
+    HPControlKind kind;
+    uint32_t value;
+    uint64_t framebufferIdentity, expectedEpoch, objectIdentity;
+    uint64_t backingMap; /* Attach only: IOMemoryMap*, +0 */
+    uint32_t width,height;
+    uint64_t pixels, pixelBytes; /* CursorShape only: straight ARGB */
+    uint32_t hotX,hotY;
+    int32_t x,y; /* Already converted-image TOP-LEFT. */
+};
+/* FB supplies route identities from binding; they are not trusted from the
+ * accelerator's commit bytes. Only known sibling NVAccel gets that route. */
+struct HPRoutedCall {
+    HPHeader header;
+    uint64_t framebufferIdentity,producerIdentity;
+    HPOperation operation;
+    uint32_t reserved;
+    const void *input;
+    size_t inputBytes;
+    HPReply *reply;
+};
+/* CPU/legacy sources are synchronously snapshotted into preallocated S by the
+ * publisher. This is not an immutable-GPU-lease assertion. No caller A/B write. */
+struct HPCPUFrame {
+    HPHeader header;
+    HPTicket expected;
+    uint64_t cpuAddress, validLength,pitch;
+    uint32_t width,height;
+};
+static_assert(sizeof(HPControl)==88 && sizeof(HPRoutedCall)==56 && sizeof(HPCPUFrame)==72,"lifecycle ABI");
+#endif
diff --git a/publication/HyperVPublicationTransport.cpp b/publication/HyperVPublicationTransport.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..05eee24c8091daa999d542f3e1164e07ebbb72c9
--- /dev/null
+++ b/publication/HyperVPublicationTransport.cpp
@@ -0,0 +1,122 @@
+#include "PublicationAdapters.hpp"
+
+static bool span(const void *p,size_t n) {return p && n && n-1<=UINTPTR_MAX-(uintptr_t)p;}
+static bool overlap(const void *a,size_t an,const void *b,size_t bn) {
+    return (uintptr_t)a<=(uintptr_t)b+bn-1 && (uintptr_t)b<=(uintptr_t)a+an-1;
+}
+static PCTicket ticket(HPTicket t) {return {t.output,t.epoch,t.ownerGeneration,t.producerToken};}
+static HPTicket ticket(PCTicket t) {return {t.output,t.epoch,t.owner_generation,t.producer_token};}
+static PCGeometry geometry(HPGeometry g) {return {g.width,g.height,g.format,(size_t)g.aperturePitch,(size_t)g.apertureLength};}
+static HPGeometry geometry(PCGeometry g) {return {g.width,g.height,g.format,0,g.aperture_pitch,g.aperture_length};}
+static bool same(HPTicket a,PCTicket b) {
+    return a.output==b.output && a.epoch==b.epoch && a.ownerGeneration==b.owner_generation && a.producerToken==b.producer_token;
+}
+static void reply(HPTransport *t,HPReply *out,HPStatus status,PCStatus core,PCResult r) {
+    auto s=pc_snapshot(&t->coordinator);
+    HPReply v{};v.header={sizeof(v),HP_ABI_VERSION};v.status=status;v.coreStatus=(uint32_t)core;
+    v.flags=(t->exactRows?HP_REPLY_EXACT_ROWS:HP_REPLY_FULL_ONLY)|(s.ready?HP_REPLY_READY:0u)|(s.debt.kind!=PC_DEBT_EMPTY?HP_REPLY_DEBT:0u);
+    if(r.pixels_established)v.flags|=HP_REPLY_PIXELS_ESTABLISHED;
+    if(r.notify_attempted)v.flags|=HP_REPLY_NOTIFY_ATTEMPTED;
+    if(r.notification_queued)v.flags|=HP_REPLY_QUEUED;
+    v.ticket=ticket(s.ticket);v.geometry=geometry(s.geometry);v.acceptedSerial=s.last_accepted_serial;
+    *out=v;
+}
+PCStatus hp_init_private_bound(HPTransport *t,uint64_t output,uint64_t fb,uint64_t accel,
+                              PCStorage storage,PCGeometry g,PCOps ops) {
+    if(!span(t,sizeof(*t)) || (uintptr_t)t%alignof(HPTransport) || !fb || !accel || fb==accel || !ops.write_rows || !ops.enqueue)return PC_BAD_INPUT;
+    /* Prohibit backing buffers from aliasing any endpoint field, not just the
+     * nested PCState validated by pc_init. These spans are checked numerically. */
+    if(!span(storage.reference,storage.reference_capacity)||!span(storage.row_mask,storage.mask_capacity)||
+       overlap(t,sizeof(*t),storage.reference,storage.reference_capacity)||
+       overlap(t,sizeof(*t),storage.row_mask,storage.mask_capacity))return PC_BAD_INPUT;
+    auto st=pc_init(&t->coordinator,output,storage);if(st!=PC_OK)return st;
+    t->operations=ops;t->framebufferIdentity=fb;t->acceleratorIdentity=accel;
+    t->allowAccelerated=false;t->allowLegacy=false;
+    t->exactRows=false;t->finalize=nullptr;t->finalizeContext=nullptr;
+    return pc_finish_mode(&t->coordinator,g);
+}
+PCStatus hp_begin_mode(HPTransport *t){
+    if(!t)return PC_BAD_INPUT;
+    t->allowAccelerated=false;t->allowLegacy=false;
+    return pc_begin_mode(&t->coordinator);
+}
+PCStatus hp_finish_mode(HPTransport *t,PCGeometry g){return t?pc_finish_mode(&t->coordinator,g):PC_BAD_INPUT;}
+PCStatus hp_feature_full(HPTransport *t,bool session) {
+    return !t?PC_BAD_INPUT:session?pc_new_notification_session(&t->coordinator):pc_request_full(&t->coordinator);
+}
+PCResult hp_idle_flush(HPTransport *t){return t?pc_flush(&t->coordinator,t->operations):PCResult{PC_BAD_INPUT,0,0,0,0,0,0};}
+
+HPStatus hp_transport_dispatch(HPTransport *t,uint64_t fb,uint64_t producer,HPOperation op,
+    const void *input,size_t inputBytes,void *output,size_t outputBytes) {
+    if(!span(t,sizeof(*t)) || (uintptr_t)t%alignof(HPTransport) || !span(input,inputBytes)||!span(output,outputBytes)||outputBytes!=sizeof(HPReply)||
+       (uintptr_t)output%alignof(HPReply)||(uintptr_t)input%alignof(HPCommit)||
+       overlap(input,inputBytes,output,outputBytes)||overlap(t,sizeof(*t),input,inputBytes)||
+       overlap(t,sizeof(*t),output,outputBytes))return HPStatus::BadBuffer;
+    auto &storage=t->coordinator.storage;
+    if(!span(storage.reference,storage.reference_capacity)||!span(storage.row_mask,storage.mask_capacity))return HPStatus::BadBuffer;
+    if(overlap(output,outputBytes,storage.reference,storage.reference_capacity)||
+       overlap(output,outputBytes,storage.row_mask,storage.mask_capacity))return HPStatus::BadBuffer;
+    auto *out=static_cast<HPReply *>(output);
+    PCResult r{};PCStatus st=PC_OK;HPStatus status=HPStatus::Ok;
+    if(fb!=t->framebufferIdentity || (producer!=t->acceleratorIdentity && producer!=fb))status=HPStatus::WrongRoute;
+    size_t needed=0;
+    switch(op){case HPOperation::Describe:needed=sizeof(HPDescribe);break;
+      case HPOperation::Acquire:needed=sizeof(HPAcquire);break;
+      case HPOperation::Commit:needed=sizeof(HPCommit);break;
+      case HPOperation::Revoke:needed=sizeof(HPRevoke);break;
+      default:status=HPStatus::BadRequest;break;}
+    if(status==HPStatus::Ok && inputBytes!=needed)status=HPStatus::BadBuffer;
+    if(status==HPStatus::Ok){
+        const auto *h=static_cast<const HPHeader *>(input);
+        if(h->bytes!=needed)status=HPStatus::BadBuffer;
+        else if(h->version!=HP_ABI_VERSION)status=HPStatus::BadVersion;
+    }
+    if(status!=HPStatus::Ok){reply(t,out,status,PC_BAD_INPUT,r);return status;}
+    auto current=pc_snapshot(&t->coordinator);
+    switch(op){
+    case HPOperation::Describe:{
+        const auto &q=*static_cast<const HPDescribe *>(input);
+        if(q.expectedOutput && q.expectedOutput!=current.ticket.output)st=PC_STALE;
+        break;}
+    case HPOperation::Acquire:{
+        const auto &q=*static_cast<const HPAcquire *>(input);
+        if(q.reserved || (q.owner!=PC_OWNER_ACCELERATED && q.owner!=PC_OWNER_LEGACY))status=HPStatus::BadRequest;
+        else if((q.owner==PC_OWNER_ACCELERATED && producer!=t->acceleratorIdentity)||
+                (q.owner==PC_OWNER_LEGACY && producer!=fb))status=HPStatus::WrongRoute;
+        else if((q.owner==PC_OWNER_ACCELERATED && !t->allowAccelerated)||
+                (q.owner==PC_OWNER_LEGACY && !t->allowLegacy))st=PC_NOT_READY;
+        else if(!same(q.expected,current.ticket))st=PC_STALE;
+        else st=pc_acquire(&t->coordinator,(PCOwner)q.owner);
+        break;}
+    case HPOperation::Revoke:{
+        const auto &q=*static_cast<const HPRevoke *>(input);
+        if(!same(q.ticket,current.ticket))st=PC_STALE;
+        else if((current.owner==PC_OWNER_ACCELERATED && producer!=t->acceleratorIdentity)||
+                (current.owner==PC_OWNER_LEGACY && producer!=fb))status=HPStatus::WrongRoute;
+        else {t->allowAccelerated=false;t->allowLegacy=false;st=pc_revoke(&t->coordinator);}
+        break;}
+    case HPOperation::Commit:{
+        const auto &q=*static_cast<const HPCommit *>(input);
+        if((q.flags&~(HP_COMMIT_VERIFY_COMPOSED|HP_COMMIT_SAMPLE_WORDS)) || q.reserved || q.geometry.reserved || q.source.reserved ||
+           q.source.flags!=HP_LEASE_COMPLETED_CACHED_IMMUTABLE || !q.source.leaseIdentity ||
+           !q.source.cpuAddress || !span((const void *)(uintptr_t)q.source.cpuAddress,(size_t)q.source.validLength)||
+           overlap((const void *)(uintptr_t)q.source.cpuAddress,(size_t)q.source.validLength,output,outputBytes)||
+           overlap((const void *)(uintptr_t)q.source.cpuAddress,(size_t)q.source.validLength,t,sizeof(*t)))
+            status=HPStatus::BadRequest;
+        else if((current.owner==PC_OWNER_ACCELERATED && producer!=t->acceleratorIdentity)||
+                (current.owner==PC_OWNER_LEGACY && producer!=fb))status=HPStatus::WrongRoute;
+        else if((current.owner==PC_OWNER_ACCELERATED && !t->allowAccelerated)||
+                (current.owner==PC_OWNER_LEGACY && !t->allowLegacy))st=PC_NOT_READY;
+        else {
+            PCFrame frame{};frame.size=sizeof(frame);frame.version=PC_VERSION;
+            frame.flags=t->exactRows&&current.owner==PC_OWNER_ACCELERATED?0u:PC_FRAME_FORCE_FULL;
+            frame.ticket=ticket(q.ticket);frame.serial=q.serial;frame.geometry=geometry(q.geometry);
+            frame.source={(const unsigned char *)(uintptr_t)q.source.cpuAddress,(size_t)q.source.pitch,(size_t)q.source.validLength};
+            r=pc_commit_finalized(&t->coordinator,frame,t->operations,t->finalize,t->finalizeContext);st=r.status;
+        }
+        break;}
+    default:status=HPStatus::BadRequest;break;
+    }
+    if(status==HPStatus::Ok && st!=PC_OK)status=HPStatus::CoreRejected;
+    reply(t,out,status,st,r);return status;
+}
diff --git a/publication/PublicationAdapters.hpp b/publication/PublicationAdapters.hpp
new file mode 100644
index 0000000000000000000000000000000000000000..7490146ba9952b1a2b792449f2fc45e85aa2b436
--- /dev/null
+++ b/publication/PublicationAdapters.hpp
@@ -0,0 +1,69 @@
+#ifndef PUBLICATION_ADAPTERS_HPP
+#define PUBLICATION_ADAPTERS_HPP
+#include "HyperVCompletedFrameAbi.hpp"
+#include "core/publication-coordinator.h"
+
+/* Complete headless adapter module; not linked/registered in the baseline kext
+ * snapshots. A Darwin owner controller must bind private A before constructing
+ * this endpoint. External graphics-gate serialization is mandatory. */
+struct HPTransport {
+    PCState coordinator;
+    PCOps operations;
+    uint64_t framebufferIdentity,acceleratorIdentity;
+    bool allowAccelerated,allowLegacy;
+    bool exactRows; /* Trusted control policy, never caller-supplied damage. */
+    PCFinalize finalize;
+    void *finalizeContext;
+};
+PCStatus hp_init_private_bound(HPTransport *,uint64_t output,uint64_t framebuffer,
+    uint64_t accelerator,PCStorage,PCGeometry,PCOps);
+PCStatus hp_begin_mode(HPTransport *);
+PCStatus hp_finish_mode(HPTransport *,PCGeometry);
+PCStatus hp_feature_full(HPTransport *,bool notificationSessionChanged);
+PCResult hp_idle_flush(HPTransport *);
+HPStatus hp_transport_dispatch(HPTransport *,uint64_t framebuffer,uint64_t producer,
+    HPOperation,const void *input,size_t inputBytes,void *output,size_t outputBytes);
+
+/* Framebuffer relay binds an already-validated accelerator provider. The IDs
+ * come from the kernel service binding, NEVER from caller-controlled wire data.
+ * The concrete IOService wrapper must validate outer param lengths first. */
+using HPTransportCall=HPStatus (*)(void *,uint64_t,uint64_t,HPOperation,
+                                 const void *,size_t,void *,size_t);
+struct HPFramebufferRelay {
+    uint64_t framebufferIdentity,acceleratorIdentity;
+    HPTransportCall call;
+    void *context;
+};
+HPStatus hp_framebuffer_forward(const HPFramebufferRelay *,uint64_t knownCaller,
+    HPOperation,const void *,size_t,HPReply *);
+
+/* Caller retains the staging lease and holds its reuse lock until this returns.
+ * No call here submits DMA, maps memory, retains private Apple types, or selects
+ * a source IOSurface. Described geometry/ticket are from successful acquisition. */
+struct NVCompletedFrameView {
+    const unsigned char *cpu;
+    uint64_t validLength,pitch,leaseIdentity,sourceIdentity;
+};
+HPStatus nv_submit_completed_frame(const HPFramebufferRelay *,uint64_t knownCaller,
+    const HPReply *acquisition,uint64_t serial,NVCompletedFrameView,HPReply *);
+
+/* Public libkern adapters. Opt in only AFTER Apple object/runtime qualification.
+ * Their target implementation has no dependency on private IOAccel layouts. */
+void hp_use_qualified_kernel_memory(PCOps *);
+
+/* Called under the same publication gate by real framebuffer lifecycle hooks.
+ * Successful setup/WSAA are recorded facts, not inferred from object presence.
+ * Fallback is sticky until a new controller lifetime in this first candidate. */
+struct HPOwnerController {
+    HPTransport *transport;
+    bool setupComplete,wsaaAccelerated,cursorFallback,legacySeeded,deferred;
+};
+using HPSeedLegacy=int (*)(void *,const unsigned char *,size_t,PCGeometry);
+void hp_owner_init(HPOwnerController *,HPTransport *,bool bootBackingSeeded);
+PCStatus hp_owner_mode_begin(HPOwnerController *);
+PCStatus hp_owner_mode_finish(HPOwnerController *,PCGeometry);
+PCStatus hp_owner_setup_result(HPOwnerController *,uint64_t epoch,bool succeeded);
+PCStatus hp_owner_wsaa_result(HPOwnerController *,uint64_t epoch,bool succeeded,bool accelerated);
+PCStatus hp_owner_completed_source(HPOwnerController *,PCTicket capturedTicket);
+PCStatus hp_owner_to_legacy(HPOwnerController *,bool cursorFailure,HPSeedLegacy,void *);
+#endif
diff --git a/publication/PublicationOwnerController.cpp b/publication/PublicationOwnerController.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..7a77e488365f7792dccb9d70534c18bb3f1b8589
--- /dev/null
+++ b/publication/PublicationOwnerController.cpp
@@ -0,0 +1,68 @@
+#include "PublicationAdapters.hpp"
+void hp_owner_init(HPOwnerController *c,HPTransport *t,bool seeded) {
+    if(!c)return;
+    *c={t,false,false,false,seeded,false};
+    if(t){t->allowAccelerated=false;t->allowLegacy=false;}
+}
+PCStatus hp_owner_mode_begin(HPOwnerController *c) {
+    if(!c||!c->transport)return PC_BAD_INPUT;
+    // WSAA is an observed output state, not a mode-generation notification.
+    // IOGraphics doSetDisplayMode -> suspend(false) -> setupForCurrentConfig
+    // need not issue another WSAA attribute. Preserve the last successful
+    // explicit state while revoking tokens; new setup and new S remain required.
+    c->setupComplete=false;c->legacySeeded=false;
+    return hp_begin_mode(c->transport);
+}
+PCStatus hp_owner_mode_finish(HPOwnerController *c,PCGeometry g) {
+    return c&&c->transport?hp_finish_mode(c->transport,g):PC_BAD_INPUT;
+}
+PCStatus hp_owner_setup_result(HPOwnerController *c,uint64_t epoch,bool ok) {
+    if(!c||!c->transport)return PC_BAD_INPUT;
+    auto s=pc_snapshot(&c->transport->coordinator);
+    if(epoch!=s.ticket.epoch || !s.ready)return PC_STALE;
+    c->setupComplete=ok;
+    if(!ok){c->transport->allowAccelerated=false;c->transport->allowLegacy=false;return pc_revoke(&c->transport->coordinator);}
+    c->transport->allowLegacy=c->legacySeeded && !c->wsaaAccelerated && !c->deferred;
+    return PC_OK;
+}
+PCStatus hp_owner_wsaa_result(HPOwnerController *c,uint64_t epoch,bool ok,bool accelerated) {
+    if(!c||!c->transport)return PC_BAD_INPUT;
+    auto s=pc_snapshot(&c->transport->coordinator);
+    if(epoch!=s.ticket.epoch || !s.ready)return PC_STALE;
+    c->wsaaAccelerated=ok&&accelerated;
+    c->deferred=!ok; /* Only a successful explicit exit can clear defer. */
+    c->transport->allowAccelerated=false; /* New completed S is still required. */
+    c->transport->allowLegacy=ok&&!accelerated&&c->setupComplete&&c->legacySeeded;
+    return PC_OK;
+}
+PCStatus hp_owner_completed_source(HPOwnerController *c,PCTicket captured) {
+    if(!c||!c->transport)return PC_BAD_INPUT;
+    auto s=pc_snapshot(&c->transport->coordinator);
+    if(captured.output!=s.ticket.output||captured.epoch!=s.ticket.epoch||
+       captured.owner_generation!=s.ticket.owner_generation||captured.producer_token!=s.ticket.producer_token)return PC_STALE;
+    if(!s.ready||!c->setupComplete||!c->wsaaAccelerated||c->cursorFallback||c->deferred)return PC_NOT_READY;
+    if(s.owner==PC_OWNER_LEGACY){
+        auto st=pc_revoke(&c->transport->coordinator);if(st!=PC_OK)return st;
+    }
+    c->transport->allowLegacy=false;c->transport->allowAccelerated=true;
+    return PC_OK;
+}
+PCStatus hp_owner_to_legacy(HPOwnerController *c,bool cursorFailure,HPSeedLegacy seed,void *context) {
+    if(!c||!c->transport)return PC_BAD_INPUT;
+    auto *t=c->transport;
+    auto previous=pc_snapshot(&t->coordinator);
+    t->allowAccelerated=false;t->allowLegacy=false;
+    c->cursorFallback=c->cursorFallback||cursorFailure;
+    c->wsaaAccelerated=false;
+    auto st=pc_revoke(&t->coordinator); /* Close admission before returning cursor failure. */
+    if(st!=PC_OK)return st;
+    if(previous.reference_valid&&previous.image_established){
+        c->legacySeeded=false;
+        if(!seed||seed(context,t->coordinator.storage.reference,
+                        size_t(previous.geometry.width)*4,previous.geometry)!=0)return PC_STORE_FAILED;
+        c->legacySeeded=true;
+    }
+    if(!c->legacySeeded)return PC_NOT_READY;
+    t->allowLegacy=c->setupComplete && !c->deferred;
+    return t->allowLegacy?PC_OK:PC_NOT_READY;
+}
diff --git a/publication/core/publication-coordinator.c b/publication/core/publication-coordinator.c
new file mode 100644
index 0000000000000000000000000000000000000000..acd07011cbff28c024a83634aacbf6d2b5213f97
--- /dev/null
+++ b/publication/core/publication-coordinator.c
@@ -0,0 +1,305 @@
+#include "publication-coordinator.h"
+
+#define PC_MAGIC UINT64_C(0x504355424c495348)
+#if defined(__cplusplus)
+#define PC_ALIGNOF(t) alignof(t)
+#define PC_ZERO {}
+#else
+#define PC_ALIGNOF(t) _Alignof(t)
+#define PC_ZERO {0}
+#endif
+
+static int range_ok(const void *p, size_t n) {
+    return p && n && n-1 <= UINTPTR_MAX-(uintptr_t)p;
+}
+static int overlaps(const void *a, size_t an, const void *b, size_t bn) {
+    return (uintptr_t)a <= (uintptr_t)b+(bn-1) &&
+           (uintptr_t)b <= (uintptr_t)a+(an-1);
+}
+static int state_address(const PCState *s) {
+    return range_ok(s,sizeof(*s)) && (uintptr_t)s % PC_ALIGNOF(PCState)==0;
+}
+static PCStatus check(const PCState *s, int allow_busy) {
+    if (!state_address(s) || s->magic!=PC_MAGIC) return PC_BAD_INPUT;
+    if (s->busy && !allow_busy) return PC_BUSY;
+    if (s->stopped) return PC_STOPPED;
+    if (s->exhausted) return PC_EXHAUSTED;
+    return PC_OK;
+}
+static PCStatus exhaust(PCState *s) {
+    s->exhausted=1;
+    s->producer_token=0;
+    s->owner=PC_OWNER_NONE;
+    s->reference_valid=0;
+    s->image_established=0;
+    s->debt.kind=PC_DEBT_FULL;
+    s->debt.first_row=0;
+    s->debt.end_row=s->geometry.height;
+    return PC_EXHAUSTED;
+}
+static PCStatus full(PCState *s) {
+    if (s->debt_revision==UINT64_MAX) return exhaust(s);
+    ++s->debt_revision;
+    s->debt.kind=PC_DEBT_FULL;
+    s->debt.first_row=0;
+    s->debt.end_row=s->geometry.height;
+    return PC_OK;
+}
+static PCStatus add_rows(PCState *s, uint32_t first, uint32_t end) {
+    if (first==end) return PC_OK;
+    if (s->debt_revision==UINT64_MAX) return exhaust(s);
+    ++s->debt_revision;
+    if (s->debt.kind==PC_DEBT_FULL) return PC_OK;
+    if (s->debt.kind==PC_DEBT_EMPTY) {
+        s->debt.kind=PC_DEBT_ROWS;
+        s->debt.first_row=first; s->debt.end_row=end;
+    } else {
+        if (first<s->debt.first_row) s->debt.first_row=first;
+        if (end>s->debt.end_row) s->debt.end_row=end;
+    }
+    return PC_OK;
+}
+static int geometry_ok(const PCState *s, PCGeometry g) {
+    size_t row, bytes, masks;
+    if (!g.width || !g.height || g.format!=PC_BGRA8888) return 0;
+    row=(size_t)g.width*4;
+    if (row/4!=g.width || g.height>SIZE_MAX/row) return 0;
+    if (g.aperture_pitch<row || g.height-1>(SIZE_MAX-row)/g.aperture_pitch ||
+        g.aperture_length<(g.height-1)*g.aperture_pitch+row) return 0;
+    bytes=row*g.height;
+    masks=g.height/8+(g.height%8!=0);
+    return bytes<=s->storage.reference_capacity && masks<=s->storage.mask_capacity;
+}
+static int view_ok(ExactRowView v, size_t row, size_t height) {
+    if (!range_ok(v.bytes,v.length) || v.pitch<row) return 0;
+    if (height-1>(SIZE_MAX-row)/v.pitch) return 0;
+    return v.length>=(height-1)*v.pitch+row;
+}
+static int view_disjoint(const PCState *s, ExactRowView v) {
+    return !overlaps(v.bytes,v.length,s,sizeof(*s)) &&
+        !overlaps(v.bytes,v.length,s->storage.reference,s->storage.reference_capacity) &&
+        !overlaps(v.bytes,v.length,s->storage.row_mask,s->storage.mask_capacity);
+}
+static PCTicket ticket(const PCState *s) {
+    PCTicket t={s->output,s->epoch,s->owner_generation,s->producer_token};
+    return t;
+}
+static int ticket_matches(const PCState *s, PCTicket t) {
+    return t.output==s->output && t.epoch==s->epoch &&
+        t.owner_generation==s->owner_generation && t.producer_token &&
+        t.producer_token==s->producer_token;
+}
+static PCResult result(const PCState *s, PCStatus status) {
+    PCResult r={status,0,0,0,0,0,0};
+    if (state_address(s) && s->magic==PC_MAGIC) {
+        r.debt_retained=(s->debt.kind!=PC_DEBT_EMPTY);
+        r.accepted_serial=s->last_accepted_serial;
+    }
+    return r;
+}
+
+PCStatus pc_init(PCState *s, uint64_t output, PCStorage storage) {
+    PCState zero=PC_ZERO;
+    if (!state_address(s) || !output ||
+        !range_ok(storage.reference,storage.reference_capacity) ||
+        !range_ok(storage.row_mask,storage.mask_capacity)) return PC_BAD_INPUT;
+    if (overlaps(s,sizeof(*s),storage.reference,storage.reference_capacity) ||
+        overlaps(s,sizeof(*s),storage.row_mask,storage.mask_capacity) ||
+        overlaps(storage.reference,storage.reference_capacity,
+                 storage.row_mask,storage.mask_capacity)) return PC_BAD_INPUT;
+    *s=zero;
+    s->magic=PC_MAGIC; s->storage=storage; s->output=output;
+    s->epoch=1; s->owner_generation=1; s->session=1; s->debt_revision=1;
+    s->transitioning=1; s->debt.kind=PC_DEBT_FULL;
+    return PC_OK;
+}
+PCSnapshot pc_snapshot(const PCState *s) {
+    PCSnapshot v=PC_ZERO;
+    if (!state_address(s) || s->magic!=PC_MAGIC) return v;
+    v.ticket=ticket(s); v.geometry=s->geometry; v.owner=s->owner;
+    v.debt=s->debt; v.last_seen_serial=s->last_seen_serial;
+    v.last_accepted_serial=s->last_accepted_serial;
+    v.session=s->session; v.debt_revision=s->debt_revision;
+    v.ready=s->ready; v.transitioning=s->transitioning;
+    v.reference_valid=s->reference_valid; v.image_established=s->image_established;
+    v.busy=s->busy; v.stopped=s->stopped; v.exhausted=s->exhausted;
+    return v;
+}
+PCStatus pc_begin_mode(PCState *s) {
+    PCStatus st=check(s,0); if (st!=PC_OK) return st;
+    if (s->epoch==UINT64_MAX || s->owner_generation==UINT64_MAX) return exhaust(s);
+    ++s->epoch; ++s->owner_generation;
+    s->ready=0; s->transitioning=1; s->producer_token=0; s->owner=PC_OWNER_NONE;
+    s->reference_valid=0; s->image_established=0;
+    s->last_seen_serial=0; s->last_accepted_serial=0;
+    return full(s);
+}
+PCStatus pc_finish_mode(PCState *s, PCGeometry g) {
+    PCStatus st=check(s,0); if (st!=PC_OK) return st;
+    if (!s->transitioning) return PC_NOT_READY;
+    if (!geometry_ok(s,g)) return PC_BAD_INPUT;
+    s->geometry=g; s->ready=1; s->transitioning=0;
+    s->reference_valid=0; s->image_established=0;
+    return full(s);
+}
+PCStatus pc_acquire(PCState *s, PCOwner owner) {
+    PCStatus st=check(s,0); if (st!=PC_OK) return st;
+    if (owner!=PC_OWNER_ACCELERATED && owner!=PC_OWNER_LEGACY) return PC_BAD_INPUT;
+    if (!s->ready || s->transitioning || s->owner!=PC_OWNER_NONE) return PC_NOT_READY;
+    if (s->owner_generation==UINT64_MAX || s->next_token==UINT64_MAX) return exhaust(s);
+    ++s->owner_generation; s->producer_token=++s->next_token; s->owner=owner;
+    s->reference_valid=0; s->image_established=0;
+    s->last_seen_serial=0; s->last_accepted_serial=0;
+    return full(s);
+}
+PCStatus pc_revoke(PCState *s) {
+    PCStatus st=check(s,0); if (st!=PC_OK) return st;
+    if (s->owner_generation==UINT64_MAX) return exhaust(s);
+    ++s->owner_generation; s->producer_token=0; s->owner=PC_OWNER_NONE;
+    s->reference_valid=0; s->image_established=0;
+    s->last_seen_serial=0; s->last_accepted_serial=0;
+    return full(s);
+}
+PCStatus pc_stop(PCState *s) {
+    PCStatus st=check(s,0);
+    if (st!=PC_OK && st!=PC_EXHAUSTED && st!=PC_STOPPED) return st;
+    s->stopped=1; s->ready=0; s->producer_token=0; s->owner=PC_OWNER_NONE;
+    s->reference_valid=0; s->image_established=0;
+    s->debt.kind=PC_DEBT_FULL; s->debt.first_row=0; s->debt.end_row=s->geometry.height;
+    return PC_OK;
+}
+PCStatus pc_request_full(PCState *s) {
+    PCStatus st=check(s,1); return st==PC_OK ? full(s) : st;
+}
+PCStatus pc_request_rows(PCState *s, uint32_t first, uint32_t end) {
+    PCStatus st=check(s,1); if (st!=PC_OK) return st;
+    if (!s->ready || !s->image_established) return PC_NOT_READY;
+    if (first>end || end>s->geometry.height) return PC_BAD_INPUT;
+    return add_rows(s,first,end);
+}
+PCStatus pc_new_notification_session(PCState *s) {
+    PCStatus st=check(s,1); if (st!=PC_OK) return st;
+    if (s->session==UINT64_MAX) return exhaust(s);
+    ++s->session;
+    return full(s);
+}
+
+static void flush_locked(PCState *s, PCOps ops, PCResult *r) {
+    if (s->debt.kind!=PC_DEBT_EMPTY && s->ready && s->image_established && !s->exhausted) {
+        PCNotice n=PC_ZERO;
+        n.size=(uint32_t)sizeof(n); n.version=PC_VERSION;
+        n.output=s->output; n.epoch=s->epoch; n.session=s->session;
+        n.debt_revision=s->debt_revision; n.width=s->geometry.width; n.height=s->geometry.height;
+        n.x2=n.width; n.y1=s->debt.first_row; n.y2=s->debt.end_row; n.kind=s->debt.kind;
+        r->notify_attempted=1;
+        r->notification_queued=(ops.enqueue(ops.context,&n)==0);
+        /* A newer FULL/session request during this synchronous callback must
+         * survive even a successful old enqueue. Conservative duplicate debt
+         * is intentional; there is no host-consumption acknowledgement. */
+        if (r->notification_queued && !s->exhausted && n.session==s->session &&
+            n.debt_revision==s->debt_revision) {
+            s->debt.kind=PC_DEBT_EMPTY; s->debt.first_row=0; s->debt.end_row=0;
+        }
+    }
+    r->debt_retained=(s->debt.kind!=PC_DEBT_EMPTY);
+    if (s->exhausted) r->status=PC_EXHAUSTED;
+}
+PCResult pc_flush(PCState *s, PCOps ops) {
+    PCStatus st=check(s,0);
+    PCResult r=result(s,st);
+    if (st!=PC_OK) return r;
+    if (!ops.enqueue) { r.status=PC_BAD_INPUT; return r; }
+    if (!s->ready || !s->image_established) { r.status=PC_NOT_READY; return r; }
+    s->busy=1; flush_locked(s,ops,&r); s->busy=0;
+    return r;
+}
+
+PCResult pc_commit(PCState *s, PCFrame f, PCOps ops) {
+    return pc_commit_finalized(s,f,ops,0,0);
+}
+PCResult pc_commit_finalized(PCState *s,PCFrame f,PCOps ops,PCFinalize finalize,void *finalize_context) {
+    PCStatus st=check(s,0);
+    PCResult r=result(s,st);
+    ExactRowDamage external={EXACT_ROW_EMPTY,EXACT_ROW_REFERENCE_NOT_USED,0,0,0};
+    ExactRowDamage writes;
+    ExactRowView reference;
+    size_t row, visible;
+    if (st!=PC_OK) return r;
+    if (f.size!=sizeof(f) || f.version!=PC_VERSION || f.reserved ||
+        (f.flags & ~(PC_FRAME_ACTUAL_SNAPSHOT|PC_FRAME_FORCE_FULL)) ||
+        !f.serial || !ops.write_rows || !ops.enqueue) { r.status=PC_BAD_INPUT; return r; }
+    if (!s->ready || s->transitioning || s->owner==PC_OWNER_NONE) { r.status=PC_NOT_READY; return r; }
+    if (!ticket_matches(s,f.ticket)) { r.status=PC_STALE; return r; }
+    if (f.serial<=s->last_seen_serial) { r.status=PC_OLD_SERIAL; return r; }
+    if (f.geometry.width!=s->geometry.width || f.geometry.height!=s->geometry.height ||
+        f.geometry.format!=s->geometry.format || f.geometry.aperture_pitch!=s->geometry.aperture_pitch ||
+        f.geometry.aperture_length!=s->geometry.aperture_length) { r.status=PC_BAD_INPUT; return r; }
+    row=(size_t)f.geometry.width*4; visible=row*f.geometry.height;
+    if (!view_ok(f.source,row,f.geometry.height) || !view_disjoint(s,f.source)) {
+        r.status=PC_BAD_INPUT; return r;
+    }
+    if ((f.flags&PC_FRAME_ACTUAL_SNAPSHOT) &&
+        (!view_ok(f.actual,row,f.geometry.height) || !view_disjoint(s,f.actual))) {
+        r.status=PC_BAD_INPUT; return r;
+    }
+    reference.bytes=s->storage.reference; reference.pitch=row; reference.length=visible;
+    s->busy=1;
+    if (f.flags&PC_FRAME_ACTUAL_SNAPSHOT) {
+        external=exact_row_damage(f.geometry.width,f.geometry.height,f.actual,reference,
+            (int)s->reference_valid,s->storage.row_mask,s->storage.mask_capacity,ops.compare,ops.compare_context);
+        reference=f.actual;
+    }
+    writes=exact_row_damage(f.geometry.width,f.geometry.height,f.source,reference,
+        !(f.flags&PC_FRAME_FORCE_FULL) && ((f.flags&PC_FRAME_ACTUAL_SNAPSHOT) || s->reference_valid),
+        s->storage.row_mask,s->storage.mask_capacity,ops.compare,ops.compare_context);
+    /* All views validated before either call. Primitive BAD_INPUT is still a
+     * hard refusal, never EMPTY or permission to suppress notification. */
+    if (external.kind==EXACT_ROW_BAD_INPUT || writes.kind==EXACT_ROW_BAD_INPUT) {
+        s->busy=0; r.status=PC_BAD_INPUT; return r;
+    }
+    if (!s->reference_valid || (f.flags&PC_FRAME_FORCE_FULL)) st=full(s);
+    else if (external.kind==EXACT_ROW_UNION)
+        st=add_rows(s,(uint32_t)external.first_row,(uint32_t)external.end_row);
+    if (st==PC_OK && writes.kind==EXACT_ROW_UNION)
+        st=add_rows(s,(uint32_t)writes.first_row,(uint32_t)writes.end_row);
+    if (st!=PC_OK) { s->busy=0; return result(s,st); }
+    s->last_seen_serial=f.serial;
+    PCWrite w=PC_ZERO;
+    w.ticket=f.ticket; w.serial=f.serial; w.geometry=f.geometry;
+    w.source=f.source; w.row_mask=s->storage.row_mask; w.mask_bytes=writes.mask_bytes;
+    if (writes.kind==EXACT_ROW_UNION) {
+        r.store_attempted=1;
+        if (ops.write_rows(ops.context,&w)!=0) {
+            s->reference_valid=0; s->image_established=0;
+            st=full(s); s->busy=0;
+            r.status=st==PC_OK ? PC_STORE_FAILED : st;
+            r.debt_retained=1;
+            return r;
+        }
+    }
+    if (finalize && finalize(finalize_context,&w)!=0) {
+        s->reference_valid=0; s->image_established=0;
+        st=full(s);s->busy=0;
+        r.status=st==PC_OK?PC_STORE_FAILED:st;
+        r.debt_retained=1;
+        return r;
+    }
+    if (s->exhausted) { s->busy=0; r.status=PC_EXHAUSTED; r.debt_retained=1; return r; }
+    /* In the private/owned S-vs-R route, every unselected row was compared
+     * exactly equal to R; leave it untouched. Invalid R/FORCE_FULL produces an
+     * all-row mask. Actual-D MUST NOT use W-only promotion: S may equal D while
+     * differing from old R (E nonempty, W empty). Keep full promotion there. */
+    for (size_t y=0;y<f.geometry.height;++y) {
+        if (!(f.flags&PC_FRAME_ACTUAL_SNAPSHOT) &&
+            !(s->storage.row_mask[y/8] & (1u << (y%8)))) continue;
+        unsigned char *destination=s->storage.reference+y*row;
+        const unsigned char *source=f.source.bytes+y*f.source.pitch;
+        if (ops.copy_reference) ops.copy_reference(ops.copy_context,destination,source,row);
+        else for (size_t x=0;x<row;++x) destination[x]=source[x];
+    }
+    s->reference_valid=1; s->image_established=1; s->last_accepted_serial=f.serial;
+    r.pixels_established=1; r.accepted_serial=f.serial; r.status=PC_OK;
+    flush_locked(s,ops,&r);
+    s->busy=0;
+    return r;
+}
diff --git a/publication/core/publication-coordinator.h b/publication/core/publication-coordinator.h
new file mode 100644
index 0000000000000000000000000000000000000000..adbea9aa0a2214cd5ae1709ac14a2d2442c3e59f
--- /dev/null
+++ b/publication/core/publication-coordinator.h
@@ -0,0 +1,154 @@
+#ifndef PUBLICATION_COORDINATOR_H
+#define PUBLICATION_COORDINATOR_H
+#include <stddef.h>
+#include <stdint.h>
+#include "vendor/exact-row-damage.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PC_VERSION 1u
+#define PC_CORE_REVISION 4u
+#define PC_BGRA8888 1u
+#define PC_FRAME_ACTUAL_SNAPSHOT 1u
+#define PC_FRAME_FORCE_FULL 2u
+
+typedef enum PCStatus {
+    PC_OK=0, PC_BAD_INPUT, PC_NOT_READY, PC_STALE, PC_OLD_SERIAL,
+    PC_BUSY, PC_STORE_FAILED, PC_EXHAUSTED, PC_STOPPED
+} PCStatus;
+typedef enum PCOwner { PC_OWNER_NONE=0, PC_OWNER_ACCELERATED=1, PC_OWNER_LEGACY=2 } PCOwner;
+typedef enum PCDebtKind { PC_DEBT_EMPTY=0, PC_DEBT_ROWS=1, PC_DEBT_FULL=2 } PCDebtKind;
+
+typedef struct PCGeometry {
+    uint32_t width, height, format;
+    size_t aperture_pitch, aperture_length; /* Committed destination layout. */
+} PCGeometry;
+typedef struct PCTicket {
+    uint64_t output, epoch, owner_generation, producer_token;
+} PCTicket;
+typedef struct PCStorage {
+    unsigned char *reference; size_t reference_capacity;
+    unsigned char *row_mask; size_t mask_capacity;
+} PCStorage;
+typedef struct PCDebt { PCDebtKind kind; uint32_t first_row, end_row; } PCDebt;
+
+/* Caller-allocated state, not a wire ABI. Fields are exposed for storage only:
+ * do not change or copy a live state. All APIs require external serialization.
+ * This object and its storage must outlive callbacks and be mutually disjoint. */
+typedef struct PCState {
+    uint64_t magic;
+    PCStorage storage;
+    PCGeometry geometry;
+    uint64_t output, epoch, owner_generation, next_token, producer_token;
+    uint64_t last_seen_serial, last_accepted_serial;
+    uint64_t session, debt_revision;
+    PCOwner owner;
+    PCDebt debt;
+    unsigned ready, transitioning, reference_valid, image_established;
+    unsigned busy, stopped, exhausted;
+} PCState;
+
+typedef struct PCFrame {
+    uint32_t size, version, flags, reserved;
+    PCTicket ticket;
+    uint64_t serial;
+    PCGeometry geometry;
+    ExactRowView source;       /* Completed immutable S, cached RAM only. */
+    ExactRowView actual;       /* Immutable full D captured under SAME lease. */
+} PCFrame;
+
+/* Synchronous callback descriptions, not a cross-kext wire ABI. */
+typedef struct PCWrite {
+    PCTicket ticket;
+    uint64_t serial;
+    PCGeometry geometry;
+    ExactRowView source;
+    const unsigned char *row_mask;
+    size_t mask_bytes;
+} PCWrite;
+typedef struct PCNotice {
+    uint32_t size, version;
+    uint64_t output, epoch, session, debt_revision;
+    uint32_t width, height, x1, y1, x2, y2; /* Exclusive right/bottom. */
+    PCDebtKind kind;
+} PCNotice;
+
+typedef struct PCOps {
+    /* 0 means ALL selected rows established and existing publication ordering
+     * completed. Nonzero means possibly partial stores: strict invalidation.
+     * The source/mask remain borrowed and immutable. No async DMA here. */
+    int (*write_rows)(void *context, const PCWrite *write);
+    /* 0 means synchronous ring enqueue only, never host consumption. */
+    int (*enqueue)(void *context, const PCNotice *notice);
+    void *context;
+    ExactRowCompare compare; /* NULL = pinned scalar exact-row primitive. */
+    void *compare_context;
+    /* Optional trusted exact cached-R copy: copy exactly n bytes, no allocation,
+     * failure, asynchronous work, callback reentry or writes outside dst[0,n).
+     * Source/destination are validated disjoint. NULL uses scalar byte stores.
+     * This is NOT the aperture store callback and introduces no new fence. */
+    void (*copy_reference)(void *context, unsigned char *destination,
+                           const unsigned char *source, size_t n);
+    void *copy_context;
+} PCOps;
+
+typedef struct PCResult {
+    PCStatus status;
+    unsigned pixels_established; /* This input accepted, even if send fails. */
+    unsigned store_attempted;
+    unsigned notify_attempted, notification_queued, debt_retained;
+    uint64_t accepted_serial;
+} PCResult;
+typedef struct PCSnapshot {
+    PCTicket ticket;
+    PCGeometry geometry;
+    PCOwner owner;
+    PCDebt debt;
+    uint64_t last_seen_serial, last_accepted_serial, session, debt_revision;
+    unsigned ready, transitioning, reference_valid, image_established;
+    unsigned busy, stopped, exhausted;
+} PCSnapshot;
+
+/* New output identity must be nonzero and never reused for a replaced output.
+ * Init does not touch backing bytes. Initial state requires finish_mode. */
+PCStatus pc_init(PCState *state, uint64_t output, PCStorage storage);
+PCSnapshot pc_snapshot(const PCState *state);
+/* begin_mode revokes admission BEFORE external mode work. On failure/rollback,
+ * finish_mode(old geometry) commits it under the NEW epoch, never the old one. */
+PCStatus pc_begin_mode(PCState *state);
+PCStatus pc_finish_mode(PCState *state, PCGeometry geometry);
+PCStatus pc_acquire(PCState *state, PCOwner owner);
+PCStatus pc_revoke(PCState *state);
+PCStatus pc_stop(PCState *state); /* Terminal; no memory freed by the core. */
+
+/* Only these debt mutations may be called reentrantly from write/finalize/enqueue.
+ * They must still be serialized, not invoked from a concurrent receive thread.
+ * session reset means bytes/mode preserved; otherwise revoke/begin_mode too. */
+PCStatus pc_request_full(PCState *state);
+/* Integration extension: already-established composed cursor rows. Checked
+ * coordinates, same gate, durable revisioned notification debt. This does not
+ * assert pixel establishment or change uncursored R. Empty input is a no-op. */
+PCStatus pc_request_rows(PCState *state, uint32_t first_row, uint32_t end_row);
+PCStatus pc_new_notification_session(PCState *state);
+
+/* Synchronous; caller holds one publication lease from BEFORE D capture until
+ * return. No allocation, locking, RM, MMIO capture, source fencing or lifetime
+ * management is supplied here. Numeric validation cannot prove ownership.
+ * A retained notification debt is not permission for a second pixel writer. */
+PCResult pc_commit(PCState *state, PCFrame frame, PCOps ops);
+/* Optional synchronous finalizer for admitted frames, including EMPTY. Called
+ * after selected-row stores, BEFORE R promotion, acceptedSerial or notification.
+ * Source/mask stay borrowed and immutable. No allocation, upstream callback or
+ * asynchronous work. Nonzero invalidates R/image and retains FULL debt exactly
+ * like a failed store. NULL preserves the established pc_commit behavior. */
+typedef int (*PCFinalize)(void *context,const PCWrite *frame);
+PCResult pc_commit_finalized(PCState *state,PCFrame frame,PCOps ops,
+                             PCFinalize finalize,void *finalize_context);
+PCResult pc_flush(PCState *state, PCOps ops); /* Retry with no new producer frame. */
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/publication/core/vendor/exact-row-damage.c b/publication/core/vendor/exact-row-damage.c
new file mode 100644
index 0000000000000000000000000000000000000000..f9b54a8735b665dfc9d007993de77ed43f1f95bc
--- /dev/null
+++ b/publication/core/vendor/exact-row-damage.c
@@ -0,0 +1,72 @@
+#include "exact-row-damage.h"
+
+/* Inclusive bounds avoid constructing the unrepresentable UINTPTR_MAX+1. */
+static int address_range(const unsigned char *p, size_t n) {
+    return p != NULL && n != 0 && n-1 <= UINTPTR_MAX-(uintptr_t)p;
+}
+static int overlap(const unsigned char *a, size_t an,
+                   const unsigned char *b, size_t bn) {
+    uintptr_t first_a=(uintptr_t)a, first_b=(uintptr_t)b;
+    return first_a <= first_b+(bn-1) && first_b <= first_a+(an-1);
+}
+static int view_valid(ExactRowView view, size_t row_bytes, size_t height) {
+    if (view.pitch < row_bytes || !address_range(view.bytes,view.length)) return 0;
+    if (height-1 > (SIZE_MAX-row_bytes)/view.pitch) return 0;
+    return view.length >= (height-1)*view.pitch+row_bytes;
+}
+static int scalar_compare(const unsigned char *a, const unsigned char *b, size_t n) {
+    unsigned different=0;
+#if defined(__clang__)
+#pragma clang loop vectorize(disable) interleave(disable)
+#elif defined(_MSC_VER)
+#pragma loop(no_vector)
+#endif
+    for (size_t i=0;i<n;++i) different |= (unsigned)(a[i]^b[i]);
+    return different != 0;
+}
+
+ExactRowDamage exact_row_damage(size_t width, size_t height,
+    ExactRowView current, ExactRowView reference, int reference_valid,
+    unsigned char *changed_rows, size_t mask_capacity,
+    ExactRowCompare compare, void *compare_context) {
+    ExactRowDamage result={EXACT_ROW_BAD_INPUT,EXACT_ROW_REFERENCE_NOT_USED,0,0,0};
+    if (!width || !height || width > SIZE_MAX/4) return result;
+    size_t row_bytes=width*4;
+    /* This form cannot overflow even when height==SIZE_MAX. */
+    size_t mask_bytes=height/8+(height%8 != 0);
+    if (!view_valid(current,row_bytes,height) || mask_capacity < mask_bytes ||
+        !address_range(changed_rows,mask_capacity)) return result;
+    if (overlap(changed_rows,mask_bytes,current.bytes,current.length)) return result;
+    if (reference_valid && address_range(reference.bytes,reference.length) &&
+        overlap(changed_rows,mask_bytes,reference.bytes,reference.length)) return result;
+    int use_reference=reference_valid && view_valid(reference,row_bytes,height);
+    result.reference=!reference_valid ? EXACT_ROW_REFERENCE_UNESTABLISHED :
+        use_reference ? EXACT_ROW_REFERENCE_COMPARED : EXACT_ROW_REFERENCE_UNUSABLE;
+    result.kind=EXACT_ROW_EMPTY;
+    result.mask_bytes=mask_bytes;
+    /* Mask bytes are ordinary caller-owned cached RAM. Volatile byte stores
+     * prevent an optimizer from replacing this small clear with an unreviewed
+     * runtime memset (which could use SIMD). This is not an MMIO access/fence. */
+    volatile unsigned char *mask_clear=changed_rows;
+#if defined(__clang__)
+#pragma clang loop vectorize(disable) interleave(disable)
+#elif defined(_MSC_VER)
+#pragma loop(no_vector)
+#endif
+    for (size_t i=0;i<mask_bytes;++i) mask_clear[i]=0;
+    for (size_t y=0;y<height;++y) {
+        int changed=1;
+        if (use_reference) {
+            const unsigned char *a=current.bytes+y*current.pitch;
+            const unsigned char *b=reference.bytes+y*reference.pitch;
+            changed=(compare ? compare(a,b,row_bytes,compare_context) : scalar_compare(a,b,row_bytes)) != 0;
+        }
+        if (changed) {
+            changed_rows[y/8] |= (unsigned char)(1u << (y%8));
+            if (result.kind==EXACT_ROW_EMPTY) result.first_row=y;
+            result.kind=EXACT_ROW_UNION;
+            result.end_row=y+1;
+        }
+    }
+    return result;
+}
diff --git a/publication/core/vendor/exact-row-damage.h b/publication/core/vendor/exact-row-damage.h
new file mode 100644
index 0000000000000000000000000000000000000000..b61639b871a8877ee4b8fcbd483963ec199e5cd6
--- /dev/null
+++ b/publication/core/vendor/exact-row-damage.h
@@ -0,0 +1,77 @@
+#ifndef EXACT_ROW_DAMAGE_H
+#define EXACT_ROW_DAMAGE_H
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Cached, CPU-readable, stable memory only. No MMIO/device pointers. The caller
+ * establishes completion/coherency/lifetime and keeps both views immutable for
+ * the entire call. No source/surface identity shortcut is part of this API. */
+typedef struct ExactRowView {
+    const unsigned char *bytes;
+    size_t pitch;
+    size_t length;
+} ExactRowView;
+
+/* Trusted adapter contract: compare exactly n accessible bytes, zero if equal,
+ * nonzero otherwise; no input/mask writes, sampling, hashes, padding reads,
+ * allocation or notification. Must accept arbitrary byte alignment. Private
+ * context may hold instrumentation but must not alias input or mask storage;
+ * this opaque context contract is the trusted adapter's responsibility.
+ * NULL selects scalar. */
+typedef int (*ExactRowCompare)(const unsigned char *current,
+    const unsigned char *reference, size_t n, void *context);
+
+typedef enum ExactRowKind {
+    EXACT_ROW_BAD_INPUT = 0, /* Not an empty result. Caller must not suppress work. */
+    EXACT_ROW_EMPTY = 1,
+    EXACT_ROW_UNION = 2
+} ExactRowKind;
+
+typedef enum ExactRowReference {
+    EXACT_ROW_REFERENCE_NOT_USED = 0, /* BAD_INPUT only. */
+    EXACT_ROW_REFERENCE_COMPARED = 1,
+    EXACT_ROW_REFERENCE_UNESTABLISHED = 2,
+    EXACT_ROW_REFERENCE_UNUSABLE = 3
+} ExactRowReference;
+
+typedef struct ExactRowDamage {
+    ExactRowKind kind;
+    ExactRowReference reference;
+    size_t first_row;
+    size_t end_row;       /* Exclusive. EMPTY/BAD_INPUT both report 0,0. */
+    size_t mask_bytes;    /* Written bytes, zero on BAD_INPUT. */
+} ExactRowDamage;
+
+/* width/height > 0; visible row bytes are exactly width*4 (BGRA incl. alpha).
+ * Independent pitches must cover that width; the final row needs no padding.
+ * Caller supplies ceil(height/8) writable mask bytes. Bit (y%8) of byte y/8
+ * means row y changed. Unused high bits are zero; excess mask capacity is not
+ * touched. A UNION denotes [0,width) x [first_row,end_row), bridging row gaps.
+ *
+ * reference_valid==0 ignores the reference view and forces every row changed.
+ * If reference_valid!=0 but its geometry/range is unusable, also force full.
+ * This does not establish a reference or carry notification debt forward.
+ *
+ * BAD_INPUT rejects invalid current geometry/ranges, missing/short mask, or
+ * mask overlap with current or an address-valid, asserted reference extent.
+ * It writes no mask bytes and invokes no callback. The caller must use its
+ * explicit error/full-frame fallback, not interpret BAD_INPUT as no damage.
+ * Buffers must actually be mapped and accessible: numeric validation cannot
+ * prove allocation ownership, mapping, coherency or epoch validity.
+ *
+ * No allocation, SIMD intrinsics, libc calls, writer or notification occurs.
+ * Integration must also prohibit compiler-generated unqualified SIMD/builtins
+ * with the kernel's compilation settings; see INTEGRATION.md. */
+ExactRowDamage exact_row_damage(size_t width, size_t height,
+    ExactRowView current, ExactRowView reference, int reference_valid,
+    unsigned char *changed_rows, size_t mask_capacity,
+    ExactRowCompare compare, void *compare_context);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/publication/cursor/owned_cursor.c b/publication/cursor/owned_cursor.c
new file mode 100644
index 0000000000000000000000000000000000000000..1920796ac887a86b8cd2f9674654b8576bd1a6fc
--- /dev/null
+++ b/publication/cursor/owned_cursor.c
@@ -0,0 +1,322 @@
+#include "owned_cursor.h"
+#ifdef __cplusplus
+#define OC_ZERO {}
+#else
+#define OC_ZERO {0}
+#endif
+
+static int oc_range_valid(const void *p, size_t bytes)
+{
+    return p != NULL && bytes <= UINTPTR_MAX - (uintptr_t)p;
+}
+
+static int oc_ranges_overlap(const void *a, size_t an, const void *b, size_t bn)
+{
+    uintptr_t ap = (uintptr_t)a, bp = (uintptr_t)b;
+    return ap < bp + bn && bp < ap + an;
+}
+
+static int oc_screen_valid(uint32_t w, uint32_t h)
+{
+    return w != 0 && h != 0 && w <= INT32_MAX && h <= INT32_MAX;
+}
+
+static int oc_wants_software(const oc_cursor *c)
+{
+    return c->has_shape && (c->force_software || c->has_invert ||
+        c->width > OC_HARDWARE_MAX_SHAPE ||
+        c->height > OC_HARDWARE_MAX_SHAPE);
+}
+
+static void oc_add_rows(oc_cursor *c, oc_rows r)
+{
+    if (r.first == r.end) return;
+    if (c->pending_rows.first == c->pending_rows.end) c->pending_rows = r;
+    else {
+        if (r.first < c->pending_rows.first) c->pending_rows.first = r.first;
+        if (r.end > c->pending_rows.end) c->pending_rows.end = r.end;
+    }
+}
+
+oc_rows oc_affected_rows(const oc_cursor *c)
+{
+    oc_rows r = {0, 0};
+    int64_t left, top, right, bottom;
+    if (!c || !c->cpu_enabled || !c->has_shape || !c->visible) return r;
+    left = c->x;
+    top = c->y;
+    right = left + c->width;
+    bottom = top + c->height;
+    if (right <= 0 || left >= c->screen_width || bottom <= 0 ||
+        top >= c->screen_height) return r;
+    r.first = top < 0 ? 0 : (uint32_t)top;
+    r.end = bottom > c->screen_height ? c->screen_height : (uint32_t)bottom;
+    return r;
+}
+
+static oc_result oc_can_mutate(const oc_cursor *c)
+{
+    if (!c || !c->pixels || !oc_screen_valid(c->screen_width, c->screen_height))
+        return OC_INVALID;
+    if (c->outstanding.kind != OC_ACTION_NONE) return OC_BUSY;
+    if (c->intent_serial == UINT64_MAX) return OC_EXHAUSTED;
+    return OC_OK;
+}
+
+static void oc_finish_mutation(oc_cursor *c, oc_rows old)
+{
+    ++c->intent_serial;
+    oc_add_rows(c, old);
+    c->cpu_enabled = oc_wants_software(c) && c->hidden_enqueued;
+    oc_add_rows(c, oc_affected_rows(c));
+}
+
+oc_result oc_init(oc_cursor *c, uint32_t *storage, size_t capacity,
+                  uint32_t screen_width, uint32_t screen_height)
+{
+    oc_cursor empty = OC_ZERO;
+    if (!c || !storage || capacity == 0 ||
+        capacity > SIZE_MAX / sizeof(uint32_t) ||
+        !oc_screen_valid(screen_width, screen_height)) return OC_INVALID;
+    if (!oc_range_valid(c, sizeof(*c)) ||
+        !oc_range_valid(storage, capacity * sizeof(uint32_t)) ||
+        oc_ranges_overlap(c, sizeof(*c), storage, capacity * sizeof(uint32_t)))
+        return OC_INVALID;
+    *c = empty;
+    c->pixels = storage;
+    c->capacity_pixels = capacity;
+    c->screen_width = screen_width;
+    c->screen_height = screen_height;
+    c->channel_generation = c->intent_serial = c->next_ticket = 1;
+    return OC_OK;
+}
+
+oc_result oc_set_shape(oc_cursor *c, const uint32_t *pixels, size_t available,
+                       uint32_t width, uint32_t height,
+                       uint32_t hot_x, uint32_t hot_y)
+{
+    oc_result result = oc_can_mutate(c);
+    oc_rows old;
+    size_t count, i;
+    int has_invert = 0;
+    if (result != OC_OK) return result;
+    if (!pixels || width == 0 || height == 0 || width > OC_MAX_SHAPE ||
+        height > OC_MAX_SHAPE || hot_x >= width || hot_y >= height)
+        return OC_INVALID;
+    count = (size_t)width * height;
+    if (count > available || count > c->capacity_pixels) return OC_INVALID;
+    if (!oc_range_valid(pixels, count * sizeof(uint32_t)) ||
+        oc_ranges_overlap(pixels, count * sizeof(uint32_t), c, sizeof(*c)) ||
+        (pixels != c->pixels && oc_ranges_overlap(pixels, count * sizeof(uint32_t),
+         c->pixels, c->capacity_pixels * sizeof(uint32_t)))) return OC_INVALID;
+    old = oc_affected_rows(c);
+    /* Input can be this same storage; other overlapping ranges are rejected.
+     * Validate every bound before modifying any accepted state or pixel.
+     */
+    for (i = 0; i < count; ++i) {
+        uint32_t p = pixels[i];
+        c->pixels[i] = p;
+        if (p == OC_INVERT_PIXEL) has_invert = 1;
+    }
+    c->width = width;
+    c->height = height;
+    c->hot_x = hot_x;
+    c->hot_y = hot_y;
+    c->has_shape = 1;
+    c->has_invert = has_invert;
+    c->shape_enqueued = c->position_enqueued = 0;
+    oc_finish_mutation(c, old);
+    return OC_OK;
+}
+
+oc_result oc_set_position(oc_cursor *c, int32_t x, int32_t y, int visible)
+{
+    oc_result result = oc_can_mutate(c);
+    oc_rows old;
+    if (result != OC_OK) return result;
+    if (visible != 0 && visible != 1) return OC_INVALID;
+    old = oc_affected_rows(c);
+    c->x = x;
+    c->y = y;
+    c->visible = visible;
+    c->position_enqueued = 0;
+    oc_finish_mutation(c, old);
+    return OC_OK;
+}
+
+oc_result oc_force_software(oc_cursor *c, int enabled)
+{
+    oc_result result = oc_can_mutate(c);
+    oc_rows old;
+    if (result != OC_OK) return result;
+    if (enabled != 0 && enabled != 1) return OC_INVALID;
+    old = oc_affected_rows(c);
+    c->force_software = enabled;
+    c->shape_enqueued = c->position_enqueued = 0;
+    oc_finish_mutation(c, old);
+    return OC_OK;
+}
+
+static void oc_invalidate_remote(oc_cursor *c)
+{
+    c->cpu_enabled = 0;
+    c->hidden_enqueued = c->shape_enqueued = c->position_enqueued = 0;
+    c->pending_rows.first = 0;
+    c->pending_rows.end = c->screen_height;
+    ++c->intent_serial;
+}
+
+oc_result oc_set_mode(oc_cursor *c, uint32_t width, uint32_t height)
+{
+    oc_result result = oc_can_mutate(c);
+    if (result != OC_OK) return result;
+    if (!oc_screen_valid(width, height)) return OC_INVALID;
+    c->screen_width = width;
+    c->screen_height = height;
+    oc_invalidate_remote(c);
+    return OC_OK;
+}
+
+oc_result oc_channel_reset(oc_cursor *c)
+{
+    oc_result result = oc_can_mutate(c);
+    if (result != OC_OK) return result;
+    if (c->channel_generation == UINT64_MAX) return OC_EXHAUSTED;
+    ++c->channel_generation;
+    oc_invalidate_remote(c);
+    return OC_OK;
+}
+
+oc_result oc_next_action(oc_cursor *c, oc_action *action)
+{
+    oc_action a = OC_ZERO;
+    if (!c || !action || !c->pixels) return OC_INVALID;
+    if (c->outstanding.kind != OC_ACTION_NONE) return OC_BUSY;
+    if (!c->hidden_enqueued && (oc_wants_software(c) ||
+        !c->has_shape || !c->shape_enqueued || !c->visible))
+        a.kind = OC_ACTION_HIDE;
+    else if (c->pending_rows.first != c->pending_rows.end)
+        a.kind = OC_ACTION_REPAINT;
+    else if (!oc_wants_software(c) && c->has_shape && !c->shape_enqueued)
+        a.kind = OC_ACTION_SHAPE;
+    else if (!oc_wants_software(c) && c->has_shape && !c->position_enqueued)
+        a.kind = OC_ACTION_POSITION;
+    if (a.kind == OC_ACTION_NONE) {
+        *action = a;
+        return OC_OK;
+    }
+    if (c->next_ticket == UINT64_MAX) return OC_EXHAUSTED;
+    a.ticket = c->next_ticket++;
+    a.channel_generation = c->channel_generation;
+    a.intent_serial = c->intent_serial;
+    a.rows = c->pending_rows;
+    a.pixels = c->pixels;
+    a.width = c->width;
+    a.height = c->height;
+    a.hot_x = c->hot_x;
+    a.hot_y = c->hot_y;
+    a.x = c->x;
+    a.y = c->y;
+    a.visible = a.kind == OC_ACTION_HIDE ? 0 : c->visible;
+    c->outstanding = a;
+    *action = a;
+    return OC_OK;
+}
+
+oc_result oc_complete_action(oc_cursor *c, const oc_action *action, int accepted)
+{
+    oc_action empty = OC_ZERO;
+    oc_action_kind kind;
+    if (!c || !action || (accepted != 0 && accepted != 1)) return OC_INVALID;
+    if (action->kind == OC_ACTION_NONE || action->kind != c->outstanding.kind ||
+        action->ticket != c->outstanding.ticket ||
+        action->channel_generation != c->channel_generation ||
+        action->intent_serial != c->intent_serial) return OC_STALE;
+    kind = c->outstanding.kind;
+    c->outstanding = empty;
+    if (!accepted) return OC_OK;
+    switch (kind) {
+    case OC_ACTION_HIDE:
+        c->hidden_enqueued = 1;
+        c->position_enqueued = 0;
+        c->cpu_enabled = oc_wants_software(c);
+        oc_add_rows(c, oc_affected_rows(c));
+        break;
+    case OC_ACTION_REPAINT:
+        c->pending_rows.first = c->pending_rows.end = 0;
+        break;
+    case OC_ACTION_SHAPE:
+        c->shape_enqueued = 1;
+        c->position_enqueued = 0;
+        break;
+    case OC_ACTION_POSITION:
+        c->position_enqueued = 1;
+        c->hidden_enqueued = !c->visible;
+        break;
+    default: return OC_INVALID;
+    }
+    return OC_OK;
+}
+
+int oc_uses_software(const oc_cursor *c) { return c && c->cpu_enabled; }
+
+oc_rows oc_pending_rows(const oc_cursor *c)
+{
+    oc_rows empty = {0, 0};
+    return c ? c->pending_rows : empty;
+}
+
+int oc_row_intersects(const oc_cursor *c, uint32_t y)
+{
+    oc_rows r = oc_affected_rows(c);
+    return y >= r.first && y < r.end;
+}
+
+uint32_t oc_blend_pixel(uint32_t base, uint32_t cursor)
+{
+    uint32_t a, result, shift;
+    if (cursor == OC_INVERT_PIXEL) return base ^ UINT32_C(0x00ffffff);
+    a = cursor >> 24;
+    result = base & UINT32_C(0xff000000);
+    for (shift = 0; shift < 24; shift += 8) {
+        uint32_t s = (cursor >> shift) & 255u;
+        uint32_t d = (base >> shift) & 255u;
+        result |= ((s * a + d * (255u - a) + 127u) / 255u) << shift;
+    }
+    return result;
+}
+
+oc_result oc_compose_row(const oc_cursor *c, uint32_t y,
+                         const uint32_t *base, size_t base_pixels,
+                         uint32_t *output, size_t output_pixels)
+{
+    size_t i;
+    size_t row_bytes;
+    int64_t left, top, right, first, end;
+    size_t source_row;
+    if (!c || !c->pixels || !base || !output || y >= c->screen_height ||
+        base_pixels < c->screen_width || output_pixels < c->screen_width)
+        return OC_INVALID;
+#if SIZE_MAX <= UINT32_MAX
+    if (c->screen_width > SIZE_MAX / sizeof(uint32_t)) return OC_INVALID;
+#endif
+    row_bytes = (size_t)c->screen_width * sizeof(uint32_t);
+    if (!oc_range_valid(base, row_bytes) || !oc_range_valid(output, row_bytes) ||
+        (base != output && oc_ranges_overlap(base, row_bytes, output, row_bytes)) ||
+        oc_ranges_overlap(output, row_bytes, c, sizeof(*c)) ||
+        oc_ranges_overlap(output, row_bytes, c->pixels,
+                          c->capacity_pixels * sizeof(uint32_t))) return OC_INVALID;
+    for (i = 0; i < c->screen_width; ++i) output[i] = base[i];
+    if (!oc_row_intersects(c, y)) return OC_OK;
+    left = c->x;
+    top = c->y;
+    right = left + c->width;
+    first = left < 0 ? 0 : left;
+    end = right > c->screen_width ? c->screen_width : right;
+    source_row = (size_t)((int64_t)y - top) * c->width;
+    for (i = (size_t)first; i < (size_t)end; ++i) {
+        size_t column = (size_t)((int64_t)i - left);
+        output[i] = oc_blend_pixel(base[i], c->pixels[source_row + column]);
+    }
+    return OC_OK;
+}
diff --git a/publication/cursor/owned_cursor.h b/publication/cursor/owned_cursor.h
new file mode 100644
index 0000000000000000000000000000000000000000..97776a6a5fbf61d00d38cd59a59df041b7c73e75
--- /dev/null
+++ b/publication/cursor/owned_cursor.h
@@ -0,0 +1,114 @@
+#ifndef OWNED_CURSOR_H
+#define OWNED_CURSOR_H
+
+/* Isolated preparation core. All calls require the same caller-owned gate.
+ * No allocation, device reads, RM calls, or host acknowledgements occur here.
+ * Pixel words are straight-alpha 0xAARRGGBB; 0x00ffffff means RGB inversion.
+ */
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define OC_MAX_SHAPE 512u
+#define OC_CORE_VERSION 1u
+#define OC_HARDWARE_MAX_SHAPE 32u
+#define OC_INVERT_PIXEL UINT32_C(0x00ffffff)
+
+typedef enum oc_result {
+    OC_OK = 0, OC_INVALID = 1, OC_BUSY = 2, OC_STALE = 3, OC_EXHAUSTED = 4
+} oc_result;
+
+typedef struct oc_rows {
+    uint32_t first; /* inclusive */
+    uint32_t end;   /* exclusive; first == end means empty */
+} oc_rows;
+
+typedef enum oc_action_kind {
+    OC_ACTION_NONE = 0,
+    OC_ACTION_HIDE = 1,
+    OC_ACTION_REPAINT = 2,
+    OC_ACTION_SHAPE = 3,
+    OC_ACTION_POSITION = 4
+} oc_action_kind;
+
+typedef struct oc_action {
+    oc_action_kind kind;
+    uint64_t ticket;
+    uint64_t channel_generation;
+    uint64_t intent_serial;
+    oc_rows rows;
+    const uint32_t *pixels; /* borrowed until complete_action; never retain */
+    uint32_t width, height, hot_x, hot_y;
+    int32_t x, y; /* converted image TOP-LEFT; never subtract hotspot again */
+    int visible;
+} oc_action;
+
+/* Public for caller-preallocated storage, not for direct field modification. */
+typedef struct oc_cursor {
+    uint32_t *pixels;
+    size_t capacity_pixels;
+    uint32_t screen_width, screen_height;
+    uint32_t width, height, hot_x, hot_y;
+    int32_t x, y;
+    int has_shape, visible, has_invert, force_software;
+    int cpu_enabled, hidden_enqueued, shape_enqueued, position_enqueued;
+    oc_rows pending_rows;
+    uint64_t channel_generation, intent_serial, next_ticket;
+    oc_action outstanding;
+} oc_cursor;
+
+oc_result oc_init(oc_cursor *c, uint32_t *shape_storage,
+                  size_t capacity_pixels, uint32_t screen_width,
+                  uint32_t screen_height);
+oc_result oc_set_shape(oc_cursor *c, const uint32_t *pixels,
+                       size_t available_pixels, uint32_t width,
+                       uint32_t height, uint32_t hot_x, uint32_t hot_y);
+/* IOGraphics setCursorState already supplies converted-image top-left.
+ * hot_x/hot_y are retained shape metadata; they do not shift this position.
+ */
+oc_result oc_set_position(oc_cursor *c, int32_t x, int32_t y, int visible);
+/* Latch on true after a hardware transport failure if CPU fallback is desired.
+ * Retry failed HIDE first: CPU composition is forbidden until hide enqueues.
+ * Clearing the latch is an explicit policy decision, never an automatic retry.
+ */
+oc_result oc_force_software(oc_cursor *c, int enabled);
+/* Both invalidate remote cursor knowledge and request full row debt. Caller
+ * independently invalidates its frame epoch/reference and establishes new R.
+ * No outstanding action is allowed; drain the synchronous action first.
+ */
+oc_result oc_set_mode(oc_cursor *c, uint32_t width, uint32_t height);
+oc_result oc_channel_reset(oc_cursor *c);
+
+/* next_action reserves one synchronous operation. Until complete_action,
+ * mutators and another next_action return OC_BUSY; composition remains valid.
+ * HIDE/SHAPE/POSITION success means packet enqueue accepted, NOT host consumed.
+ * REPAINT success means listed rows were stored using current base+cursor AND
+ * their notification debt was accepted (including prerequisite frame debt).
+ * Failure retains work. Completing REPAINT early would break switch ordering.
+ */
+oc_result oc_next_action(oc_cursor *c, oc_action *action);
+oc_result oc_complete_action(oc_cursor *c, const oc_action *action, int accepted);
+
+int oc_uses_software(const oc_cursor *c);
+oc_rows oc_affected_rows(const oc_cursor *c);
+oc_rows oc_pending_rows(const oc_cursor *c);
+int oc_row_intersects(const oc_cursor *c, uint32_t y);
+
+/* Base must be the immutable uncursored cached row R/S, never aperture A.
+ * base == output is supported for temporary cached rows, never in-place R.
+ * Other overlaps are rejected, as are output overlaps with owned shape/state.
+ * A caller may use its optimized copy for nonintersecting rows instead.
+ * Output retains base alpha. Bounds failure writes nothing.
+ */
+oc_result oc_compose_row(const oc_cursor *c, uint32_t y,
+                         const uint32_t *base, size_t base_pixels,
+                         uint32_t *output, size_t output_pixels);
+uint32_t oc_blend_pixel(uint32_t base, uint32_t cursor);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
