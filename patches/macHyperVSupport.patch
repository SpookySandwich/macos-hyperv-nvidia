+    _imageRectWidth = values[0]; _imageRectHeight = values[1];
+    _imageRectX1 = values[2]; _imageRectY1 = values[3];
+    _imageRectX2 = values[4]; _imageRectY2 = values[5];
+    _imageRectBudget = _imageRectInitialBudget = value;
+  }
+  ++_imageRectGeneration;
+  if (!publishImageRectProbeGated()) {
