+      size <= UINT32_MAX - _framebufferBase + 1) {
+    if (size <= _framebufferLength || _rangeAllocatorLow->allocateRange(
+        _framebufferBase + _framebufferLength, size - _framebufferLength)) {
+      if (size > _framebufferLength) _framebufferLength = size;
+      result = _framebufferBase;
+    }
+  }
+  if (!result) {
+    result = allocateRange(size, PAGE_SIZE, UINT32_MAX);
+    if (result) { _framebufferBase = result; _framebufferLength = size; }
