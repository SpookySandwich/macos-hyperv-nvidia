diff --git a/MacHyperVFramebuffer/PFFramebufferMemory.cpp b/MacHyperVFramebuffer/PFFramebufferMemory.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d7c0b286a726921c3d880262cdad4965bf8ce607
--- /dev/null
+++ b/MacHyperVFramebuffer/PFFramebufferMemory.cpp
@@ -0,0 +1,149 @@
+#include "PFFramebufferMemory.hpp"
+#include <mach/vm_param.h>
+
+// On the pinned LP64 XNU path this is a pending IOMemoryMap*, not a VA.
+// Do not define/use the unavailable kIOMap64Bit constant or access map fields.
+// An already-bound map is borrowed by redirect(), not newly owned here.
+static IOMemoryMap *pfRejectMapping(IOMemoryMap *pending)
+{
+    if (pending && !pending->getMemoryDescriptor()) pending->release();
+    return nullptr;
+}
+
+static bool pfAllowedOptions(IOOptionBits options)
+{
+    const IOOptionBits cache = options & kIOMapCacheMask;
+    return !(options & kIOMapStatic) &&
+        (cache == kIOMapDefaultCache || cache == kIOMapWriteCombineCache);
+}
+
+class PFWCBuffer : public IOBufferMemoryDescriptor {
+    OSDeclareDefaultStructors(PFWCBuffer);
+public:
+    static PFWCBuffer *withCapacity(IOByteCount capacity)
+    {
+        PFWCBuffer *buffer = new PFWCBuffer;
+        if (!buffer) return nullptr;
+        const IOOptionBits options = kIODirectionInOut | kIOMemoryKernelUserShared |
+            kIOMemoryMapperNone | kIOMapWriteCombineCache;
+        if (!buffer->initWithPhysicalMask(kernel_task, options, capacity, PAGE_SIZE, 0)) {
+            buffer->release();
+            return nullptr;
+        }
+        return buffer;
+    }
+
+    IOMemoryMap *makeMapping(IOMemoryDescriptor *owner, task_t task,
+                            IOVirtualAddress opaqueAddress, IOOptionBits options,
+                            IOByteCount offset, IOByteCount length) override
+    {
+        auto *pending = reinterpret_cast<IOMemoryMap *>(opaqueAddress);
+        // Check BEFORE superclass static handling and compatible-map lookup.
+        // Both argument options and pending map options matter for this ABI.
+        if (!pending || pending->getMemoryDescriptor() ||
+            !pfAllowedOptions(options) || !pfAllowedOptions(pending->getMapOptions()) ||
+            pending->getLength() == 0 || pending->getLength() > getLength())
+            return pfRejectMapping(pending);
+        return IOBufferMemoryDescriptor::makeMapping(owner, task, opaqueAddress,
+                                                      options, offset, length);
+    }
+
+    // No descriptor-level map cache rewriting / redirection is supported.
+    IOReturn redirect(task_t, bool) override { return kIOReturnUnsupported; }
+protected:
+    IOReturn doMap(vm_map_t map, IOVirtualAddress *opaqueAddress, IOOptionBits options,
+                   IOByteCount offset, IOByteCount length) override
+    {
+        // Defense in depth. makeMapping is the guard for reuse/static paths.
+        if (!pfAllowedOptions(options)) return kIOReturnUnsupported;
+        return IOBufferMemoryDescriptor::doMap(map, opaqueAddress, options, offset, length);
+    }
+};
+
+OSDefineMetaClassAndStructors(PFWCBuffer, IOBufferMemoryDescriptor);
+OSDefineMetaClassAndStructors(PFFramebufferMemory, IOMemoryDescriptor);
+
+PFFramebufferMemory *PFFramebufferMemory::withCapacity(IOByteCount capacity)
+{
+    // Bound both round-up and superclass offset+length arithmetic. No silent
+    // rounding: reported capacity and owned shared page extent are identical.
+    if (!capacity || (capacity & PAGE_MASK) || capacity > (~IOByteCount(0) / 2))
+        return nullptr;
+    auto *memory = new PFFramebufferMemory;
+    if (!memory) return nullptr;
+    if (!memory->IOMemoryDescriptor::init()) {
+        memory->release();
+        return nullptr;
+    }
+    memory->backing_ = PFWCBuffer::withCapacity(capacity);
+    if (!memory->backing_) {
+        memory->release();
+        return nullptr;
+    }
+    return memory;
+}
+
+void PFFramebufferMemory::free()
+{
+    if (backing_) { backing_->release(); backing_ = nullptr; }
+    IOMemoryDescriptor::free();
+}
+
+IOMemoryMap *PFFramebufferMemory::copyKernelMapping()
+{
+    return createMappingInTask(kernel_task, 0, kIOMapAnywhere | kIOMapWriteCombineCache);
+}
+
+IODeviceMemory *PFFramebufferMemory::copyIODeviceMemory()
+{
+    retain();
+    // IODeviceMemory is a legacy factory facade: its own withRange and
+    // withSubRange return other IOMemoryDescriptor subclasses cast to this
+    // type. This is a pinned x86_64 IOKit ABI boundary, not a C++ is-a claim.
+    // Start from the real base pointer so no derived-object offset is assumed.
+    return reinterpret_cast<IODeviceMemory *>(static_cast<IOMemoryDescriptor *>(this));
+}
+
+IOByteCount PFFramebufferMemory::getLength() const
+{
+    return backing_ ? backing_->getLength() : 0;
+}
+
+IODirection PFFramebufferMemory::getDirection() const { return kIODirectionInOut; }
+
+addr64_t PFFramebufferMemory::getPhysicalSegment(IOByteCount offset,
+                                                IOByteCount *length, IOOptionBits options)
+{
+    if (length) *length = 0;
+    if (!backing_ || offset >= backing_->getLength()) return 0;
+    // Never synthesize firstPhysical+offset. MapperNone was fixed at allocation.
+    return backing_->getPhysicalSegment(offset, length, options);
+}
+
+IOReturn PFFramebufferMemory::prepare(IODirection direction)
+{
+    return backing_ ? backing_->prepare(direction) : kIOReturnNotReady;
+}
+IOReturn PFFramebufferMemory::complete(IODirection direction)
+{
+    return backing_ ? backing_->complete(direction) : kIOReturnNotReady;
+}
+IOByteCount PFFramebufferMemory::readBytes(IOByteCount offset, void *bytes, IOByteCount length)
+{
+    return backing_ ? backing_->readBytes(offset, bytes, length) : 0;
+}
+IOByteCount PFFramebufferMemory::writeBytes(IOByteCount offset, const void *bytes, IOByteCount length)
+{
+    return backing_ ? backing_->writeBytes(offset, bytes, length) : 0;
+}
+IOReturn PFFramebufferMemory::redirect(task_t, bool) { return kIOReturnUnsupported; }
+
+IOMemoryMap *PFFramebufferMemory::makeMapping(IOMemoryDescriptor *owner, task_t task,
+                                            IOVirtualAddress opaqueAddress, IOOptionBits options,
+                                            IOByteCount offset, IOByteCount length)
+{
+    if (!backing_) return pfRejectMapping(reinterpret_cast<IOMemoryMap *>(opaqueAddress));
+    // Preserve the pending-map protocol unchanged; maps retain backing_, not
+    // the forwarding wrapper. No remap of physical runs or private map fields.
+    return backing_->makeMapping(owner, task, opaqueAddress, options, offset, length);
+}
