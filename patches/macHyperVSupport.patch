+      __offsetof(HyperVGraphicsMessageSupportedResolutionResponse, resolutions) +
+      count * sizeof(HyperVGraphicsSupportedResolution);
+  if (!count || count > kHyperVGraphicsMaxSupportedResolutions ||
+      response.defaultResolutionIndex >= count || gfxMsg.gfxHeader.size < needed)
+    return kIOReturnBadArgument;
