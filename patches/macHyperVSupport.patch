+#ifndef PF_FRAMEBUFFER_MEMORY_HPP
+#define PF_FRAMEBUFFER_MEMORY_HPP
+
+#include <IOKit/IODeviceMemory.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+
+// Source-pinned x86_64 XNU adapter, NOT a portable IOKit mapping ABI.
+// See SOURCE-CONTRACT.txt before integrating. No aperture or DMA ownership.
+#if !defined(__x86_64__) || !defined(__LP64__)
+#error PFFramebufferMemory requires the reviewed x86_64 LP64 mapping protocol
+#endif
+
+class PFWCBuffer;
+
+class PFFramebufferMemory : public IOMemoryDescriptor {
+    OSDeclareDefaultStructors(PFFramebufferMemory);
+public:
+    // +1 reference. Capacity must be nonzero and page-aligned. Wired,
+    // kernel/user shared WC RAM; physical contiguity is NOT requested.
+    static PFFramebufferMemory *withCapacity(IOByteCount capacity);
+
+    // +1 map reference. Create once before publication, hold through use.
+    // The map owns B directly and remains valid after this wrapper is released.
+    IOMemoryMap *copyKernelMapping();
+
+    // +1 legacy IOFramebuffer return-type facade, following pinned XNU's
+    // IODeviceMemory factories. Dynamic class remains PFFramebufferMemory;
+    // never OSDynamicCast to IODeviceMemory or use it as a superclass.
+    // Internal ownership stays PFFramebufferMemory*/IOMemoryDescriptor*.
+    IODeviceMemory *copyIODeviceMemory();
+
+    IOByteCount getLength() const override;
+    IODirection getDirection() const override;
+    addr64_t getPhysicalSegment(IOByteCount offset, IOByteCount *length,
+                               IOOptionBits options = 0) override;
+    IOReturn prepare(IODirection direction = kIODirectionNone) override;
+    IOReturn complete(IODirection direction = kIODirectionNone) override;
+    IOByteCount readBytes(IOByteCount offset, void *bytes, IOByteCount length) override;
+    IOByteCount writeBytes(IOByteCount offset, const void *bytes, IOByteCount length) override;
+    IOReturn redirect(task_t safeTask, bool doRedirect) override;
+    IOMemoryMap *makeMapping(IOMemoryDescriptor *owner, task_t task,
+                            IOVirtualAddress opaqueAddress, IOOptionBits options,
+                            IOByteCount offset, IOByteCount length) override;
+protected:
+    void free() override;
+private:
+    PFWCBuffer *backing_ = nullptr;
+};
+
+#endif
