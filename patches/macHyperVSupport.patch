+  if (result) {
+    setProperty("HyperVFramebufferReservedBase", result, 64);
+    setProperty("HyperVFramebufferReservedBytes", _framebufferLength, 64);
+  }
+  IOLockUnlock(_framebufferLock);
+  return result;
+}
