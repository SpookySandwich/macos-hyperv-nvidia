+  // Runs on the work loop: either the request is still pending and is removed
+  // here, or the interrupt handler has already finished delivering it.
+  //
+  *removed = false;
+  IOLockLock(_vmbusRequestsLock);
+  HyperVVMBusDeviceRequest *current  = _vmbusRequests;
+  HyperVVMBusDeviceRequest *previous = nullptr;
+  while (current != nullptr) {
+    if (current == vmbusRequest) {
+      if (previous != nullptr) {
+        previous->next = current->next;
+      } else {
+        _vmbusRequests = current->next;
+      }
+      *removed = true;
+      break;
+    }
+    previous = current;
+    current  = current->next;
+  }
+  IOLockUnlock(_vmbusRequestsLock);
+  return kIOReturnSuccess;
+}
