+void HyperVPCIBridge::sanitizeVirtualCapabilities() {
+  // Hyper-V exposes an endpoint directly below a synthetic host bridge.
+  // Its physical upstream PCIe link remains owned by Windows. Advertising
+  // L1 PM Substates makes IOPCIFamily dereference a nonexistent bridge nub.
+  // Keep the capability chain intact, with this host-only capability hidden.
+  UInt64 visited[(PAGE_SIZE / sizeof(UInt32) + 63) / 64] = {};
+  UInt32 offset = 0x100;
+  while (offset >= 0x100 && offset <= PAGE_SIZE - sizeof(UInt32) && !(offset & 3)) {
+    UInt32 index = offset / sizeof(UInt32);
+    UInt64 bit = 1ULL << (index & 63);
+    if (visited[index >> 6] & bit) { break; }
+    visited[index >> 6] |= bit;
+    UInt32 header = readPCIConfig(offset, sizeof(UInt32));
+    if (header == 0 || header == UINT32_MAX) { break; }
+    if ((header & 0xFFFF) == 0x1E) {
+      _hiddenL1PmCapability = offset;
+      _hvDevice->setProperty("HyperVPCIHiddenL1PmCapability", offset, 32);
+      break;
