+// HYPERV: a draw that samples the pass's own colour target (WindowServer's window rebuilds read the window surface
+// back for materials/vibrancy, after a memoryBarrier) must see what earlier draws in this pass wrote. A pipeline
+// barrier inside the render pass does not guarantee that here, so end the pass, barrier outside it, and resume with
+// everything loaded - the same split the mesh path uses. Without it the read returns stale/zero texels and the draw
+// (blending off) paints opaque black boxes into inactive windows (Notes' "Continue" button, Settings labels).
+- (void)nvmtlSplitForSelfRead {
+    nvmtl_vk_cmd_end_render(&_cb->_c);
+    nvmtl_vk_cmd_barrier(&_cb->_c);
+    if (![self nvmtlBeginPassLoad:NVMTL_LOAD_ALL]) {
+        _begun = NO; nvlog("encoder: render pass could not RESUME after a self-read split - the rest of this encoder is not drawn"); return; }
