+    if (gNvStageOwner != a || gNvStageClosed || gNvSProvider.closed) { IOLockUnlock(lock); return ENXIO; }
+    if (gNvSProvider.ready) { IOLockUnlock(lock); return 0; }
+    if (gNvSProvider.preparing) { IOLockUnlock(lock); return EBUSY; }
+    if (gNvSProvider.attempted) { IOLockUnlock(lock); return EIO; }
+    gNvSProvider.attempted = true; gNvSProvider.preparing = true;
+    const UInt64 epoch = gNvSProvider.epoch;
+    a->retain();
+    IOLockUnlock(lock);
+
+    NvStagePreparation preparation = {};
+    NvStageStorage *prepared = static_cast<NvStageStorage *>(IOMalloc(sizeof(NvStageStorage)));
+    if (prepared) *prepared = {};
+    int error = prepared ? nvStagePrepare(prepared, &preparation) : ENOMEM;   // no lock held
+
+    IOLockLock(lock);
+    gNvSProvider.preparing = false;
+    if (gNvStageOwner != a || gNvStageClosed || gNvSProvider.closed || epoch != gNvSProvider.epoch) {
+        error = ECANCELED;
+    } else if (!error) {
+        gNvSProvider.storage = prepared; prepared = nullptr;
+        gNvSProvider.ready = true;
+    }
+    IOLockUnlock(lock);
+    if (error) ALOG("Hyper-V completed-frame pool: preparation failed (%d, reason %u) -- console uses CPU copies",
+                    error, preparation.reason);
+    nvStageDispose(prepared);   // nothing was ever submitted to it
+    a->release();
+    return error;
+}
+
+// Terminal for this accelerator: closes admission and drains the copy lock (an admitted consumer included).
+void NvCancelCompletedS(NVAccel *a)
+{
+    IOLock *lock = __atomic_load_n(&gNvStageLock, __ATOMIC_ACQUIRE);
+    if (!a || !lock || !a->fConsoleCopyLock) return;
+    IOLockLock(lock);
+    if (gNvStageOwner != a) { IOLockUnlock(lock); return; }
+    a->retain();
+    gNvSProvider.closed = true; gNvSProvider.ready = false; ++gNvSProvider.epoch;
+    IOLockUnlock(lock);
+    IOLockLock(a->fConsoleCopyLock);   // never wait on the copy lock while holding the stage lock
+    IOLockLock(lock);
+    NvStageStorage *retired = nullptr;
+    if (!gNvSProvider.quarantined) { retired = gNvSProvider.storage; gNvSProvider.storage = nullptr; }
+    IOLockUnlock(lock);
+    IOLockUnlock(a->fConsoleCopyLock);
+    nvStageDispose(retired);
+    a->release();
+}
+
+// Caller owns live accelerator/source/RM references and has satisfied the producer completion requirement (the
+// surface's completion mark, nvSurfWaitReady). Caller must NOT hold the copy, stage or publication locks. Order:
+// stage (released) -> console pin (released) -> copy -> stage (released) -> RM -> consumer. Every outcome is terminal
+// for this frame; the caller never falls into a second writer.
+NvSProviderResult NvProduceCompletedS(NVAccel *a, NVVidMemory *vm, IOService *rm,
+    void *kapiDevice, UInt32 width, UInt32 height, UInt32 pitch,
+    NvSConsumeCompleted consume, void *context)
+{
+    IOLock *lock = __atomic_load_n(&gNvStageLock, __ATOMIC_ACQUIRE);
+    const UInt64 bytes = UInt64(pitch) * height;
+    if (!a || !vm || !rm || !kapiDevice || !consume || !lock || !a->fConsoleCopyLock ||
+        !nvStageGeometry(kNvStageCapacity, bytes, width, height, pitch)) return NvSProviderResult::InvalidSource;
+    IOLockLock(lock);
+    if (gNvStageOwner != a || gNvStageClosed || gNvSProvider.closed) { IOLockUnlock(lock); return NvSProviderResult::Cancelled; }
+    if (!gNvSProvider.ready) { IOLockUnlock(lock); return NvSProviderResult::NotReady; }
+    a->retain();
+    IOLockUnlock(lock);
+    vm->retain(); rm->retain();
+    NvConsoleSourcePin sourcePin = {};
+    if (!a->consolePinSource(vm, kapiDevice, bytes, &sourcePin)) {
+        rm->release(); vm->release(); a->release();
+        return NvSProviderResult::InvalidSource;
+    }
+    IOLockLock(a->fConsoleCopyLock);
+    IOLockLock(lock);
+    NvSProviderResult refused = NvSProviderResult::PixelsEstablished;
+    if (gNvStageOwner != a || gNvStageClosed || gNvSProvider.closed || !gNvSProvider.ready || !gNvSProvider.storage)
+        refused = NvSProviderResult::Cancelled;
+    else if (gNvSProvider.lastLease == ~UInt64(0)) refused = NvSProviderResult::LeaseExhausted;
+    else if (a->fConsoleDmaDisabled) refused = NvSProviderResult::InvalidSource;
+    if (refused != NvSProviderResult::PixelsEstablished) {
+        IOLockUnlock(lock); IOLockUnlock(a->fConsoleCopyLock);
+        a->consoleUnpinSource(&sourcePin);
+        rm->release(); vm->release(); a->release();
+        return refused;
+    }
+    const UInt64 epoch = gNvSProvider.epoch;
+    const NvStageStorage *storage = gNvSProvider.storage;
+    gNvSProvider.inFlight = true;
+    IOLockUnlock(lock);
+    NVRMSurfPageoff request = {};
+    request.version = NVRM_SS_RM_VERSION; request.status = NVRM_SS_OFF;
+    request.kapiDevice = sourcePin.device; request.kapiMemory = sourcePin.memory.handle;
+    request.pages = storage->pages; request.pageCount = (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
+    request.length = bytes;
+    const IOReturn io = rm->callPlatformFunction(storage->symbol, false, &request, nullptr, nullptr, nullptr);
+    if (io != kIOReturnSuccess || request.status) {
+        a->fConsoleDmaDisabled = true;
+        OSAddAtomic64(1, &gCntConsoleDmaRefused);
+        IOLockLock(lock);
+        gNvSProvider.quarantined = true; gNvSProvider.ready = false;
+        gNvSProvider.closed = true; gNvSProvider.inFlight = false;
+        gNvSProvider.quarantineAccelerator = a;
+        gNvSProvider.quarantineSource = vm; gNvSProvider.quarantineRm = rm;
+        gNvSProvider.quarantinePin = sourcePin;
+        IOLockUnlock(lock);
+        IOLockUnlock(a->fConsoleCopyLock);
+        ALOG("Hyper-V completed-frame copy failed: IOReturn 0x%x status 0x%x -- pool and source quarantined, CPU copies "
+             "from now on", (unsigned)io, request.status);
+        // The source allocation stays pinned and every reference above is kept: the engine may still write S.
+        return NvSProviderResult::DmaFailure;
+    }
+    IOLockLock(lock);
+    const bool admitted = gNvStageOwner == a && !gNvStageClosed && !gNvSProvider.closed && epoch == gNvSProvider.epoch;
+    const UInt64 identity = admitted ? ++gNvSProvider.lastLease : 0;
+    IOLockUnlock(lock);
+    NvSProviderResult result = NvSProviderResult::StaleRejected;
+    if (admitted) {
+        NvSCompletedView view = {};
+        view.cpuAddress = storage->aliasWords ? storage->aliasWords : storage->chunks[0].words;
+        view.validLength = bytes; view.width = width; view.height = height; view.pitch = pitch;
+        view.leaseIdentity = identity; view.sourceIdentity = sourcePin.memory.allocationCookie;
+        view.sourceRmHandle = sourcePin.memory.handle;
+        view.descriptor = storage->aliasDescriptor ? storage->aliasDescriptor : storage->chunks[0].buffer;
+        view.mapping = storage->aliasMap; view.backing = storage;
+        switch (consume(context, &view)) {
+            case NvSConsumerResult::PixelsEstablished: result = NvSProviderResult::PixelsEstablished; break;
+            case NvSConsumerResult::StaleRejected: result = NvSProviderResult::StaleRejected; break;
+            default: result = NvSProviderResult::ConsumerFailure; break;
+        }
+    }
+    IOLockLock(lock); gNvSProvider.inFlight = false; IOLockUnlock(lock);
+    IOLockUnlock(a->fConsoleCopyLock);
+    a->consoleUnpinSource(&sourcePin);   // after the copy lock
+    rm->release(); vm->release(); a->release();
+    return result;
+}
+
+// Publication consumer: hands the completed view to the framebuffer's commit. No raw aperture address in this ABI.
+struct NvPublicationContext {
+    IOService *framebuffer;
+    HPReply captured, reply;
+};
+static NvSConsumerResult nvPublicationConsume(void *opaque, const NvSCompletedView *view)
+{
+    auto *c = static_cast<NvPublicationContext *>(opaque);
+    if (!c || !view || !view->cpuAddress || !view->leaseIdentity || !view->sourceIdentity ||
+        view->width != c->captured.geometry.width || view->height != c->captured.geometry.height)
+        return NvSConsumerResult::StaleRejected;
+    HPCommit q = {};
+    q.header = {sizeof(q), HP_ABI_VERSION};
+    q.ticket = c->captured.ticket;
+    q.serial = view->leaseIdentity;
+    q.geometry = c->captured.geometry;
+    q.source = {reinterpret_cast<uint64_t>(view->cpuAddress), view->validLength, view->pitch,
+                view->leaseIdentity, view->sourceIdentity, HP_LEASE_COMPLETED_CACHED_IMMUTABLE, 0};
+    const IOReturn status = c->framebuffer->callPlatformFunction(gNvPublicationCommitSymbol, false, &q,
+        reinterpret_cast<void *>(sizeof(q)), &c->reply, reinterpret_cast<void *>(sizeof(c->reply)));
+    if (status != kIOReturnSuccess || c->reply.header.bytes != sizeof(c->reply) || c->reply.header.version != HP_ABI_VERSION)
+        return status == kIOReturnNotReady || status == kIOReturnNotAttached ?
+            NvSConsumerResult::StaleRejected : NvSConsumerResult::ConsumerFailure;
+    if (c->reply.flags & HP_REPLY_PIXELS_ESTABLISHED) return NvSConsumerResult::PixelsEstablished;
+    if (c->reply.status == HPStatus::CoreRejected && (c->reply.coreStatus == PC_STALE ||
+        c->reply.coreStatus == PC_NOT_READY || c->reply.coreStatus == PC_OLD_SERIAL || c->reply.coreStatus == PC_STOPPED))
+        return NvSConsumerResult::StaleRejected;
+    return NvSConsumerResult::ConsumerFailure;
+}
+static IOReturn nvPublicationProduce(NVAccel *a, IOService *fb, NVVidMemory *vm, unsigned w, unsigned h, unsigned pitch)
+{
+    if (!a || !fb || !vm || !w || !h || pitch < uint64_t(w) * 4 || (pitch & 3) || !gNvPublicationCommitSymbol)
+        return kIOReturnBadArgument;
+    NvPublicationContext context = {};
+    context.framebuffer = fb;
+    fb->retain(); vm->retain();
+    if (!nvPublicationDescribe(fb, &context.captured) || context.captured.geometry.width != w ||
+        context.captured.geometry.height != h) {
+        vm->release(); fb->release();
+        OSAddAtomic64(1, &gCntPublicationStale);
+        return kIOReturnNotReady;
+    }
+    NVRMRmHandles handles = {};
+    IOService *rm = nvAccelNVRM();
+    if (!rm || !nvAccelRmHandles(&handles)) { vm->release(); fb->release(); return kIOReturnNotReady; }
+    rm->retain();
+    const NvSProviderResult result = NvProduceCompletedS(a, vm, rm, handles.kapiDevice, w, h, pitch,
+                                                         nvPublicationConsume, &context);
+    rm->release(); vm->release(); fb->release();
+    if (result == NvSProviderResult::PixelsEstablished) {
+        OSAddAtomic64(1, &gCntConsoleDirect);
+        return kIOReturnSuccess;   // notification debt is the framebuffer's, never a second copy
+    }
+    if (result == NvSProviderResult::StaleRejected || result == NvSProviderResult::Cancelled ||
+        result == NvSProviderResult::NotReady) { OSAddAtomic64(1, &gCntPublicationStale); return kIOReturnNotReady; }
+    OSAddAtomic64(1, &gCntConsoleDirectRefused);
+    if (result == NvSProviderResult::DmaFailure || result == NvSProviderResult::ConsumerFailure) gConsoleDirectFailed = true;
+    return kIOReturnIOError;
+}
+// CPU fallback for the private console: the publisher snapshots the CPU source into its own S synchronously.
+static IOReturn nvPublicationCPU(IOService *fb, const void *source, uint64_t bytes, unsigned w, unsigned h, unsigned pitch)
+{
+    if (!fb || !source || !w || !h || pitch < uint64_t(w) * 4 || uint64_t(pitch) * h > bytes || !gNvPublicationCPUSymbol)
+        return kIOReturnBadArgument;
+    fb->retain();
+    HPReply captured = {}, reply = {};
+    if (!nvPublicationDescribe(fb, &captured)) { fb->release(); return kIOReturnNotReady; }
+    HPCPUFrame q = {};
+    q.header = {sizeof(q), HP_ABI_VERSION}; q.expected = captured.ticket;
+    q.cpuAddress = reinterpret_cast<uint64_t>(source); q.validLength = bytes; q.pitch = pitch; q.width = w; q.height = h;
+    const IOReturn result = fb->callPlatformFunction(gNvPublicationCPUSymbol, false, &q, reinterpret_cast<void *>(sizeof(q)),
+                                                     &reply, reinterpret_cast<void *>(sizeof(reply)));
+    fb->release();
+    if (result != kIOReturnSuccess) return result;
+    return (reply.flags & HP_REPLY_PIXELS_ESTABLISHED) ? kIOReturnSuccess : kIOReturnNotReady;
+}
+
+// Older (non-private) console: the copy engine writes the frame straight into the Hyper-V aperture, then Present.
+// The source allocation is pinned for the copy; a failed or timed-out copy keeps the pin forever and turns this path
+// off for the boot (the engine may still be writing).
+static bool nvConsoleDirectPresent(NVAccel *a, IOService *fb, NVVidMemory *vm, unsigned w, unsigned h, unsigned pitch)
+{
+    if (!a || !fb || fb != a->fFB || !nvConsoleFramebuffer(fb) || nvPrivatePublication(fb)) return false;
+    if (!gConsoleDirectMode || gConsoleDirectFailed || a->fConsoleDmaDisabled || !a->fConsoleCopyLock ||
+        !vm || !vm->fRmHandle || vm->fScanout || !w || !h || pitch < 4ull * w || (pitch & 3)) return false;
+    NVRMVramRequest q = {}; q.version = NVRM_VRAM_ABI_VERSION;
+    const UInt64 bytes = static_cast<UInt64>(pitch) * h;
+    if (bytes > vm->fBytes || bytes > kNvConsoleMaxFrameBytes ||
+        a->askFramebufferForScanout(&q, fb) != kIOReturnSuccess ||
+        q.width != w || q.height != h || q.pitch != pitch || q.actualSize < bytes ||
+        !q.kva || !q.phys || (q.phys & (PAGE_SIZE - 1))) return false;
+    NVRMRmHandles handles = {};
+    IOService *rm = nvAccelNVRM();
+    if (!rm || !nvAccelRmHandles(&handles)) return false;
+    const OSSymbol *symbol = OSSymbol::withCStringNoCopy(NVRM_SS_FN_PAGEOFF);
+    if (!symbol) return false;
+    NvConsoleSourcePin pin = {};
+    if (!a->consolePinSource(vm, handles.kapiDevice, bytes, &pin)) { symbol->release(); return false; }
+    IOLockLock(a->fConsoleCopyLock);
+    const UInt64 pages = (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
+    bool ok = !gConsoleDirectFailed;
+    if (ok && a->fConsoleDirectPageCapacity < pages) {
+        unsigned long long *list = static_cast<unsigned long long *>(IOMalloc(pages * sizeof(*list)));
+        if (!list) ok = false;
+        else {
+            if (a->fConsoleDirectPages) IOFree(a->fConsoleDirectPages, a->fConsoleDirectPageCapacity * sizeof(*list));
+            a->fConsoleDirectPages = list; a->fConsoleDirectPageCapacity = pages; a->fConsoleDirectBase = 0;
+        }
+    }
+    if (!ok) {
+        IOLockUnlock(a->fConsoleCopyLock);
+        a->consoleUnpinSource(&pin);
+        symbol->release();
+        return false;
+    }
+    if (a->fConsoleDirectBase != q.phys) {
+        for (UInt64 i = 0; i < a->fConsoleDirectPageCapacity; ++i) a->fConsoleDirectPages[i] = q.phys + i * PAGE_SIZE;
+        a->fConsoleDirectBase = q.phys;
+    }
+    NVRMSurfPageoff request = {};
+    request.version = NVRM_SS_RM_VERSION; request.status = NVRM_SS_OFF;
+    request.kapiDevice = pin.device; request.kapiMemory = pin.memory.handle;
+    request.pages = a->fConsoleDirectPages; request.pageCount = pages; request.length = bytes;
+    const IOReturn result = rm->callPlatformFunction(symbol, false, &request, nullptr, nullptr, nullptr);
+    symbol->release();
+    ok = result == kIOReturnSuccess && request.status == 0;
+    if (ok) OSAddAtomic64(1, &gCntConsoleDirect);
+    else {
+        gConsoleDirectFailed = true;
+        a->fConsoleDmaDisabled = true;
+        OSAddAtomic64(1, &gCntConsoleDirectRefused); OSAddAtomic64(1, &gCntConsoleDmaRefused);
+        ALOG("direct console DMA failed: IOReturn 0x%x status 0x%x -- CPU copies for this boot", (unsigned)result, request.status);
+    }
+    IOLockUnlock(a->fConsoleCopyLock);
+    if (!ok) return false;   // the pin (and the page list the engine may still use) is deliberately kept
+    a->consoleUnpinSource(&pin);
+    nvConsolePresent(fb, w, h);
+    return true;
+}
