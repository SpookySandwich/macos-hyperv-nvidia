+// All *Locked functions require fConsoleLock and never take the copy, stage or publication locks. Reaping returns the
+// accelerator releases owed AFTER unlock.
+unsigned NVAccel::consoleReapLocked()
+{
+    unsigned releases = 0;
+    NvConsoleAllocation **link = &fConsoleAllocations;
+    while (*link) {
+        NvConsoleAllocation *record = *link;
+        if (!record->retiring || record->pins) { link = &record->next; continue; }
+        fConsoleKms->unmapMemory(record->device, static_cast<NvKmsKapiMemory *>(record->memory.handle),
+                                 NVKMS_KAPI_MAPPING_TYPE_KERNEL, record->memory.kva);
+        fConsoleKms->freeMemory(record->device, static_cast<NvKmsKapiMemory *>(record->memory.handle));
+        fConsoleBytes -= record->memory.actualSize;
+        *link = record->next;
+        IOFree(record, sizeof(*record));
+        ++releases; // the record's retain; the caller releases outside every lock
+    }
+    if (fConsoleAllocationsClosed && !fConsoleAllocations && fConsoleDevice) {
+        fConsoleKms->freeDevice(fConsoleDevice);
+        fConsoleDevice = nullptr;
