diff --git a/build/hyperv_build.sh b/build/hyperv_build.sh
new file mode 100644
index 0000000..e1db51f
--- /dev/null
+++ b/build/hyperv_build.sh
@@ -0,0 +1,60 @@
+#!/bin/bash
+# hyperv_build.sh [<src> [<out>]]: build the Hyper-V carry of NVAccel (macOS 15) and NVRMAGDC from this tree, in the
+# macOS guest, with the same toolchain the deployed NVAccel 0.2.0 used (Xcode clang, MacHyperVSupport's MacKernelSDK,
+# open-gpu-kernel-modules 610.57.04 headers). NVRM.kext and NVRMFB.kext are NOT built: they come from the 2.3.1 release.
+#   <src>  the directory holding kexts/ and build/ (default: this script's parent)
+#   <out>  output directory (default: ~/hyperv-build/rebase-2.3.1-out)
+# Environment: HYPERV_BUILD_ROOT (default ~/hyperv-build), MACKERNELSDK, OGKM override the two header trees.
+set -euo pipefail
+HERE=$(cd "$(dirname "$0")" && pwd)
+SRC=$(cd "${1:-$HERE/..}" && pwd)
+ROOT=${HYPERV_BUILD_ROOT:-$HOME/hyperv-build}
+OUT=${2:-$ROOT/rebase-2.3.1-out}
+SDK=${MACKERNELSDK:-$ROOT/MacHyperVSupport/MacKernelSDK}
+OGKM=${OGKM:-$ROOT/ogkm610}
+NV=$OGKM/src/nvidia; KMS=$OGKM/src/nvidia-modeset
+VERSION=2.3.1d1   # CFBundleVersion; CFBundleShortVersionString is 2.3.1-hv1
+
+for d in "$SDK/Headers" "$KMS/kapi/interface" "$SRC/kexts/NVRM/accel/hyperv" "$SRC/kexts/NVRMAGDC"; do
+    [ -d "$d" ] || { echo "STOP: missing $d" >&2; exit 1; }
+done
+if git -C "$OGKM" rev-parse >/dev/null 2>&1; then
+    tag=$(git -C "$OGKM" describe --tags --exact-match 2>/dev/null || true)
+    [ "$tag" = 610.57.04 ] || { echo "STOP: $OGKM is at '${tag:-untagged}', NVRM 2.3.1 is built against 610.57.04" >&2; exit 1; }
+fi
+grep -q '^#define NVRM_VRAM_ABI_VERSION 2u' "$SRC/kexts/NVRM/nvrm_vram_abi.h" || { echo "STOP: VRAM ABI is not version 2" >&2; exit 1; }
+
+rm -rf "$OUT"; mkdir -p "$OUT/NVAccel.kext/Contents/MacOS" "$OUT/NVRMAGDC.kext/Contents/MacOS"
+FLAGS=(-target x86_64-apple-macos12.0 -isysroot "$SDK" -fapple-kext -mkernel -nostdinc
+       -DKERNEL -DKERNEL_PRIVATE -DDRIVER_PRIVATE -DAPPLE -DNeXT -std=c++17 -fno-rtti -fno-exceptions -fno-builtin
+       -fno-common -mno-red-zone -O2 -Wno-inconsistent-missing-override -Wno-deprecated-declarations -Wno-invalid-offsetof
+       -I "$SDK/Headers")
+A=$SRC/kexts/NVRM
+ACCEL_INC=(-I "$A" -I "$A/accel" -I "$A/accel/iofam" -I "$A/accel/re"
+    -I "$NV/arch/nvalloc/unix/include" -I "$NV/arch/nvalloc/common/inc"
+    -I "$OGKM/src/common/sdk/nvidia/inc" -I "$OGKM/src/common/sdk/nvidia/inc/hw"
+    -I "$OGKM/src/common/inc" -I "$OGKM/src/common/shared/inc" -I "$NV/inc" -I "$NV/interface"
+    -I "$KMS/os-interface/include" -I "$KMS/kapi/interface" -I "$KMS/kapi/include"
+    -I "$OGKM/src/common/unix/nvidia-push/interface" -I "$KMS/interface" -I "$KMS/include"
+    -I "$OGKM/src/common/unix/common/inc" -I "$OGKM/src/common/modeset"
+    -I "$OGKM/src/common/unix/common/utils/interface")
+
+echo "== NVAccel (macOS 15)"
+xcrun clang++ "${FLAGS[@]}" "${ACCEL_INC[@]}" -c "$A/accel/nvrm-accel.cpp" -o "$OUT/nvrm-accel.o"
+xcrun ld -arch x86_64 -kext -static -undefined dynamic_lookup -o "$OUT/NVAccel.kext/Contents/MacOS/NVAccel" "$OUT/nvrm-accel.o"
+cp "$A/accel/Info.plist" "$OUT/NVAccel.kext/Contents/Info.plist"
+
+echo "== NVRMAGDC"
+xcrun clang++ "${FLAGS[@]}" -I "$SRC/kexts/NVRMAGDC" -c "$SRC/kexts/NVRMAGDC/nvrm-agdc.cpp" -o "$OUT/nvrm-agdc.o"
+xcrun ld -arch x86_64 -kext -static -undefined dynamic_lookup -o "$OUT/NVRMAGDC.kext/Contents/MacOS/NVRMAGDC" "$OUT/nvrm-agdc.o"
+cp "$SRC/kexts/NVRMAGDC/Info.plist" "$OUT/NVRMAGDC.kext/Contents/Info.plist"
+
+for k in NVAccel NVRMAGDC; do
+    plutil -lint "$OUT/$k.kext/Contents/Info.plist" >/dev/null
+    [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$OUT/$k.kext/Contents/Info.plist")" = "$VERSION" ] ||
+        { echo "STOP: $k Info.plist is not version $VERSION" >&2; exit 1; }
+    codesign --force --sign - "$OUT/$k.kext"
+    echo "$k $VERSION $(shasum -a 256 "$OUT/$k.kext/Contents/MacOS/$k" | cut -d' ' -f1) $(dwarfdump --uuid "$OUT/$k.kext/Contents/MacOS/$k" | awk '{print $2}')"
+done
+rm -f "$OUT"/*.o
+echo "HYPERV_BUILD_PASS $OUT"
