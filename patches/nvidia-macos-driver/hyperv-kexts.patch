+} HyperVGraphicsPlatformFunctionSetCursorShapeParams;
+
+#endif
diff --git a/kexts/NVRM/accel/hyperv/HyperVPublicationLifecycle.hpp b/kexts/NVRM/accel/hyperv/HyperVPublicationLifecycle.hpp
new file mode 100644
index 0000000..a1224f1
--- /dev/null
+++ b/kexts/NVRM/accel/hyperv/HyperVPublicationLifecycle.hpp
@@ -0,0 +1,46 @@
+#ifndef HYPERV_PUBLICATION_LIFECYCLE_HPP
+#define HYPERV_PUBLICATION_LIFECYCLE_HPP
+#include "HyperVCompletedFrameAbi.hpp"
+/* Driver-owned synchronous kernel-only ABI. All pointers are borrowed until
+ * return. Attach retains the supplied precreated B mapping, never the FB.
+ * Neither Describe nor any other request exposes the physical aperture A. */
+#define HP_FN_CONTROL "HyperVPublicationControlV1"
+#define HP_FN_ROUTED "HyperVPublicationRoutedV1"
+#define HP_FN_CPU_FRAME "HyperVPublicationCPUFrameV1"
+enum class HPControlKind : uint32_t {
+    Attach=1, Detach, BindAccelerator, ModeBegin, ModeFinish, SetupResult,
+    Accelerated, ToLegacy, Defer, CursorInvalid, CursorShape, CursorPosition,
+    CursorRefresh, CursorUnclassified, CursorCapabilitiesRecorded
+};
+struct HPControl {
+    HPHeader header;
+    HPControlKind kind;
+    uint32_t value;
+    uint64_t framebufferIdentity, expectedEpoch, objectIdentity;
+    uint64_t backingMap; /* Attach only: IOMemoryMap*, +0 */
+    uint32_t width,height;
+    uint64_t pixels, pixelBytes; /* CursorShape only: straight ARGB */
+    uint32_t hotX,hotY;
+    int32_t x,y; /* Already converted-image TOP-LEFT. */
+};
+/* FB supplies route identities from binding; they are not trusted from the
+ * accelerator's commit bytes. Only known sibling NVAccel gets that route. */
+struct HPRoutedCall {
+    HPHeader header;
+    uint64_t framebufferIdentity,producerIdentity;
+    HPOperation operation;
+    uint32_t reserved;
+    const void *input;
+    size_t inputBytes;
+    HPReply *reply;
+};
+/* CPU/legacy sources are synchronously snapshotted into preallocated S by the
+ * publisher. This is not an immutable-GPU-lease assertion. No caller A/B write. */
+struct HPCPUFrame {
+    HPHeader header;
+    HPTicket expected;
+    uint64_t cpuAddress, validLength,pitch;
+    uint32_t width,height;
+};
+static_assert(sizeof(HPControl)==88 && sizeof(HPRoutedCall)==56 && sizeof(HPCPUFrame)==72,"lifecycle ABI");
+#endif
diff --git a/kexts/NVRM/accel/hyperv/core/publication-coordinator.h b/kexts/NVRM/accel/hyperv/core/publication-coordinator.h
new file mode 100644
index 0000000..5475059
--- /dev/null
+++ b/kexts/NVRM/accel/hyperv/core/publication-coordinator.h
@@ -0,0 +1,146 @@
+#ifndef PUBLICATION_COORDINATOR_H
+#define PUBLICATION_COORDINATOR_H
+#include <stddef.h>
+#include <stdint.h>
+#include "vendor/exact-row-damage.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define PC_VERSION 1u
+#define PC_CORE_REVISION 3u
+#define PC_BGRA8888 1u
+#define PC_FRAME_ACTUAL_SNAPSHOT 1u
+#define PC_FRAME_FORCE_FULL 2u
+
+typedef enum PCStatus {
+    PC_OK=0, PC_BAD_INPUT, PC_NOT_READY, PC_STALE, PC_OLD_SERIAL,
+    PC_BUSY, PC_STORE_FAILED, PC_EXHAUSTED, PC_STOPPED
+} PCStatus;
+typedef enum PCOwner { PC_OWNER_NONE=0, PC_OWNER_ACCELERATED=1, PC_OWNER_LEGACY=2 } PCOwner;
+typedef enum PCDebtKind { PC_DEBT_EMPTY=0, PC_DEBT_ROWS=1, PC_DEBT_FULL=2 } PCDebtKind;
+
+typedef struct PCGeometry {
+    uint32_t width, height, format;
+    size_t aperture_pitch, aperture_length; /* Committed destination layout. */
+} PCGeometry;
+typedef struct PCTicket {
+    uint64_t output, epoch, owner_generation, producer_token;
+} PCTicket;
+typedef struct PCStorage {
+    unsigned char *reference; size_t reference_capacity;
+    unsigned char *row_mask; size_t mask_capacity;
+} PCStorage;
+typedef struct PCDebt { PCDebtKind kind; uint32_t first_row, end_row; } PCDebt;
+
+/* Caller-allocated state, not a wire ABI. Fields are exposed for storage only:
+ * do not change or copy a live state. All APIs require external serialization.
+ * This object and its storage must outlive callbacks and be mutually disjoint. */
+typedef struct PCState {
+    uint64_t magic;
+    PCStorage storage;
+    PCGeometry geometry;
+    uint64_t output, epoch, owner_generation, next_token, producer_token;
+    uint64_t last_seen_serial, last_accepted_serial;
+    uint64_t session, debt_revision;
+    PCOwner owner;
+    PCDebt debt;
+    unsigned ready, transitioning, reference_valid, image_established;
+    unsigned busy, stopped, exhausted;
+} PCState;
+
+typedef struct PCFrame {
+    uint32_t size, version, flags, reserved;
+    PCTicket ticket;
+    uint64_t serial;
+    PCGeometry geometry;
+    ExactRowView source;       /* Completed immutable S, cached RAM only. */
+    ExactRowView actual;       /* Immutable full D captured under SAME lease. */
+} PCFrame;
+
+/* Synchronous callback descriptions, not a cross-kext wire ABI. */
+typedef struct PCWrite {
+    PCTicket ticket;
+    uint64_t serial;
+    PCGeometry geometry;
+    ExactRowView source;
+    const unsigned char *row_mask;
+    size_t mask_bytes;
+} PCWrite;
+typedef struct PCNotice {
+    uint32_t size, version;
+    uint64_t output, epoch, session, debt_revision;
+    uint32_t width, height, x1, y1, x2, y2; /* Exclusive right/bottom. */
+    PCDebtKind kind;
+} PCNotice;
+
+typedef struct PCOps {
+    /* 0 means ALL selected rows established and existing publication ordering
+     * completed. Nonzero means possibly partial stores: strict invalidation.
+     * The source/mask remain borrowed and immutable. No async DMA here. */
+    int (*write_rows)(void *context, const PCWrite *write);
+    /* 0 means synchronous ring enqueue only, never host consumption. */
+    int (*enqueue)(void *context, const PCNotice *notice);
+    void *context;
+    ExactRowCompare compare; /* NULL = pinned scalar exact-row primitive. */
+    void *compare_context;
+    /* Optional trusted exact cached-R copy: copy exactly n bytes, no allocation,
+     * failure, asynchronous work, callback reentry or writes outside dst[0,n).
+     * Source/destination are validated disjoint. NULL uses scalar byte stores.
+     * This is NOT the aperture store callback and introduces no new fence. */
+    void (*copy_reference)(void *context, unsigned char *destination,
+                           const unsigned char *source, size_t n);
+    void *copy_context;
+} PCOps;
+
+typedef struct PCResult {
+    PCStatus status;
+    unsigned pixels_established; /* This input accepted, even if send fails. */
+    unsigned store_attempted;
+    unsigned notify_attempted, notification_queued, debt_retained;
+    uint64_t accepted_serial;
+} PCResult;
+typedef struct PCSnapshot {
+    PCTicket ticket;
+    PCGeometry geometry;
+    PCOwner owner;
+    PCDebt debt;
+    uint64_t last_seen_serial, last_accepted_serial, session, debt_revision;
+    unsigned ready, transitioning, reference_valid, image_established;
+    unsigned busy, stopped, exhausted;
+} PCSnapshot;
+
+/* New output identity must be nonzero and never reused for a replaced output.
+ * Init does not touch backing bytes. Initial state requires finish_mode. */
+PCStatus pc_init(PCState *state, uint64_t output, PCStorage storage);
+PCSnapshot pc_snapshot(const PCState *state);
+/* begin_mode revokes admission BEFORE external mode work. On failure/rollback,
+ * finish_mode(old geometry) commits it under the NEW epoch, never the old one. */
+PCStatus pc_begin_mode(PCState *state);
+PCStatus pc_finish_mode(PCState *state, PCGeometry geometry);
+PCStatus pc_acquire(PCState *state, PCOwner owner);
+PCStatus pc_revoke(PCState *state);
+PCStatus pc_stop(PCState *state); /* Terminal; no memory freed by the core. */
+
+/* Only these debt mutations may be called reentrantly from write/enqueue.
+ * They must still be serialized, not invoked from a concurrent receive thread.
+ * session reset means bytes/mode preserved; otherwise revoke/begin_mode too. */
+PCStatus pc_request_full(PCState *state);
+/* Integration extension: already-established composed cursor rows. Checked
+ * coordinates, same gate, durable revisioned notification debt. This does not
+ * assert pixel establishment or change uncursored R. Empty input is a no-op. */
+PCStatus pc_request_rows(PCState *state, uint32_t first_row, uint32_t end_row);
+PCStatus pc_new_notification_session(PCState *state);
+
+/* Synchronous; caller holds one publication lease from BEFORE D capture until
+ * return. No allocation, locking, RM, MMIO capture, source fencing or lifetime
+ * management is supplied here. Numeric validation cannot prove ownership.
+ * A retained notification debt is not permission for a second pixel writer. */
+PCResult pc_commit(PCState *state, PCFrame frame, PCOps ops);
+PCResult pc_flush(PCState *state, PCOps ops); /* Retry with no new producer frame. */
+
+#ifdef __cplusplus
+}
