diff --git a/kexts/NVRM/accel/hyperv/core/vendor/exact-row-damage.h b/kexts/NVRM/accel/hyperv/core/vendor/exact-row-damage.h
new file mode 100644
index 0000000..b61639b
--- /dev/null
+++ b/kexts/NVRM/accel/hyperv/core/vendor/exact-row-damage.h
@@ -0,0 +1,77 @@
+#ifndef EXACT_ROW_DAMAGE_H
+#define EXACT_ROW_DAMAGE_H
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Cached, CPU-readable, stable memory only. No MMIO/device pointers. The caller
+ * establishes completion/coherency/lifetime and keeps both views immutable for
+ * the entire call. No source/surface identity shortcut is part of this API. */
+typedef struct ExactRowView {
+    const unsigned char *bytes;
+    size_t pitch;
+    size_t length;
+} ExactRowView;
+
+/* Trusted adapter contract: compare exactly n accessible bytes, zero if equal,
+ * nonzero otherwise; no input/mask writes, sampling, hashes, padding reads,
+ * allocation or notification. Must accept arbitrary byte alignment. Private
+ * context may hold instrumentation but must not alias input or mask storage;
+ * this opaque context contract is the trusted adapter's responsibility.
+ * NULL selects scalar. */
+typedef int (*ExactRowCompare)(const unsigned char *current,
+    const unsigned char *reference, size_t n, void *context);
+
+typedef enum ExactRowKind {
+    EXACT_ROW_BAD_INPUT = 0, /* Not an empty result. Caller must not suppress work. */
+    EXACT_ROW_EMPTY = 1,
+    EXACT_ROW_UNION = 2
+} ExactRowKind;
+
+typedef enum ExactRowReference {
+    EXACT_ROW_REFERENCE_NOT_USED = 0, /* BAD_INPUT only. */
+    EXACT_ROW_REFERENCE_COMPARED = 1,
+    EXACT_ROW_REFERENCE_UNESTABLISHED = 2,
+    EXACT_ROW_REFERENCE_UNUSABLE = 3
+} ExactRowReference;
+
+typedef struct ExactRowDamage {
+    ExactRowKind kind;
+    ExactRowReference reference;
+    size_t first_row;
+    size_t end_row;       /* Exclusive. EMPTY/BAD_INPUT both report 0,0. */
+    size_t mask_bytes;    /* Written bytes, zero on BAD_INPUT. */
+} ExactRowDamage;
+
+/* width/height > 0; visible row bytes are exactly width*4 (BGRA incl. alpha).
+ * Independent pitches must cover that width; the final row needs no padding.
+ * Caller supplies ceil(height/8) writable mask bytes. Bit (y%8) of byte y/8
+ * means row y changed. Unused high bits are zero; excess mask capacity is not
+ * touched. A UNION denotes [0,width) x [first_row,end_row), bridging row gaps.
+ *
+ * reference_valid==0 ignores the reference view and forces every row changed.
+ * If reference_valid!=0 but its geometry/range is unusable, also force full.
+ * This does not establish a reference or carry notification debt forward.
+ *
+ * BAD_INPUT rejects invalid current geometry/ranges, missing/short mask, or
+ * mask overlap with current or an address-valid, asserted reference extent.
+ * It writes no mask bytes and invokes no callback. The caller must use its
+ * explicit error/full-frame fallback, not interpret BAD_INPUT as no damage.
+ * Buffers must actually be mapped and accessible: numeric validation cannot
+ * prove allocation ownership, mapping, coherency or epoch validity.
+ *
+ * No allocation, SIMD intrinsics, libc calls, writer or notification occurs.
+ * Integration must also prohibit compiler-generated unqualified SIMD/builtins
+ * with the kernel's compilation settings; see INTEGRATION.md. */
+ExactRowDamage exact_row_damage(size_t width, size_t height,
+    ExactRowView current, ExactRowView reference, int reference_valid,
+    unsigned char *changed_rows, size_t mask_capacity,
+    ExactRowCompare compare, void *compare_context);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
