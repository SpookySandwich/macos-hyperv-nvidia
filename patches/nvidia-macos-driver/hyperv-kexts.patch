diff --git a/kexts/NVRM/accel/NvCompletedStaging.hpp b/kexts/NVRM/accel/NvCompletedStaging.hpp
new file mode 100644
index 0000000..67131d8
--- /dev/null
+++ b/kexts/NVRM/accel/NvCompletedStaging.hpp
@@ -0,0 +1,71 @@
+#pragma once
+#include <IOKit/IOTypes.h>
+class NVAccel;
+class NVVidMemory;
+class IOService;
+class IOMemoryDescriptor;
+class IOMemoryMap;
+
+enum class NvSConsumerResult : UInt32 {
+    PixelsEstablished = 1, StaleRejected = 2, ConsumerFailure = 3
+};
+enum class NvSProviderResult : UInt32 {
+    PixelsEstablished = 1, StaleRejected = 2, ConsumerFailure = 3,
+    NotReady = 4, InvalidSource = 5, DmaFailure = 6, Cancelled = 7,
+    LeaseExhausted = 8
+};
+struct NvSCompletedView {
+    const void *cpuAddress;
+    UInt64 validLength;
+    UInt32 width, height, pitch, reserved;
+    UInt64 leaseIdentity;             // never zero; no wrap/reuse in this boot
+    UInt64 sourceIdentity;            // actual NVVidMemory allocation cookie
+    const void *sourceRmHandle;       // identity only, never dereference
+    IOMemoryDescriptor *descriptor;   // borrowed +0; owns/backs the entire S view
+    IOMemoryMap *mapping;             // borrowed +0; null for ordinary CPU view
+    const void *backing;              // borrowed +0; private prepared pool
+};
+static_assert(sizeof(void *) == 8 && sizeof(NvSCompletedView) == 80,
+              "completed staging lease is a pinned x86_64 kernel contract");
+using NvSConsumeCompleted = NvSConsumerResult (*)(void *, const NvSCompletedView *);
+
+// Control context, before presentation starts: at most one allocation plan.
+// No copy/state/publication lock may be held. No diagnostic budget is armed.
+int NvPrepareCompletedS(NVAccel *accelerator);
+
+// Terminal cancellation for this accelerator lifetime. Closes admission and
+// drains the copy lock, including an admitted synchronous consumer. Does not
+// wait for an allocation in progress; that preparation discards its result.
+// Must not be called from the consumer or while holding the publication gate.
+void NvCancelCompletedS(NVAccel *accelerator);
+
+// Caller owns live accelerator/source/RM references for the duration of call,
+// and has satisfied the existing producer completion/fence requirement. Caller
+// captures FB Describe BEFORE this call; opaque context preserves that exact
+// ticket/FB/serial through the callback. Existing IOAccel transaction locks may
+// be held; caller must NOT hold copy/provider-state/publication locks. Ordering:
+// IOAccel caller -> short provider state (released) -> console pin (released)
+// -> copy -> short state/RM
+// -> synchronous consumer/publication gate. No state lock is held during RM or
+// consumer. Publication must never call back into FB/IOAccel/RM or the provider.
+// This preserves the existing transaction scheduling; it does not assert that
+// unobserved IOAccel internals are lock-free or independently runtime-qualified.
+// Performs ONE S-only pageoff; no A address is accepted or looked up. The copy
+// lock protects pool through callback return. Source allocation is separately
+// pinned by an authoritative owner-bound allocator record before this lock. Consumer must not retain
+// or escape any pointer, reenter this provider, or call cancellation/preparation.
+// Consumer may acquire the publication gate after RM completion. Compose and
+// bounded verification use this SAME S; no second source-generation readback.
+// PixelsEstablished takes precedence over a notification enqueue error. Every
+// outcome is terminal for this frame: caller must NOT fall into a second writer.
+NvSProviderResult NvProduceCompletedS(NVAccel *accelerator, NVVidMemory *source,
+    IOService *rm, void *kapiDevice, UInt32 width, UInt32 height, UInt32 pitch,
+    NvSConsumeCompleted consumer, void *context);
+
+// Allocation lifetime revision: pin admission requires an exact source owner
+// binding to this allocator/device and sufficient recorded allocation extent.
+// Identity comes from this protected record, not mutable VM handle/cookie fields.
+// Deallocation detaches the owner but defers physical free until last pin drops;
+// an ambiguous submitted failure preserves the pin permanently. Pin release is
+// AFTER copy/publication unlock. This proves allocation lifetime only; source
+// producer completion/content stability remain the existing caller contract.
diff --git a/kexts/NVRM/accel/hyperv/HyperVCompletedFrameAbi.hpp b/kexts/NVRM/accel/hyperv/HyperVCompletedFrameAbi.hpp
new file mode 100644
index 0000000..8d7b643
--- /dev/null
+++ b/kexts/NVRM/accel/hyperv/HyperVCompletedFrameAbi.hpp
@@ -0,0 +1,66 @@
+#ifndef HYPERV_COMPLETED_FRAME_ABI_HPP
+#define HYPERV_COMPLETED_FRAME_ABI_HPP
+#include <stddef.h>
+#include <stdint.h>
+
+/* NEW driver-owned, synchronous trusted-kernel contract. These names are not
+ * existing Apple/IOAccel private APIs. No user pointers, async leases or raw A
+ * addresses are returned. Version1 is x86_64 only and locked to full publication. */
+#define HP_FN_DESCRIBE "HyperVPublicationDescribeV1"
+#define HP_FN_ACQUIRE "HyperVPublicationAcquireV1"
+#define HP_FN_COMMIT "HyperVPublicationCommitCompletedV1"
+#define HP_FN_REVOKE "HyperVPublicationRevokeV1"
+enum { HP_ABI_VERSION=1, HP_FORMAT_BGRA8888=1 };
+enum class HPOperation : uint32_t { Describe=1, Acquire=2, Commit=3, Revoke=4 };
+enum class HPStatus : uint32_t { Ok=0, BadBuffer, BadVersion, BadRequest, WrongRoute, CoreRejected };
+enum : uint32_t {
+    HP_REPLY_FULL_ONLY=1, HP_REPLY_READY=2, HP_REPLY_PIXELS_ESTABLISHED=4,
+    HP_REPLY_NOTIFY_ATTEMPTED=8, HP_REPLY_QUEUED=16, HP_REPLY_DEBT=32
+};
+enum : uint32_t { HP_LEASE_COMPLETED_CACHED_IMMUTABLE=1 };
+enum : uint32_t { HP_COMMIT_VERIFY_COMPOSED=1, HP_COMMIT_SAMPLE_WORDS=2, HP_MAX_SAMPLE_WORDS=40 };
+struct HPHeader { uint32_t bytes, version; };
+struct HPTicket { uint64_t output, epoch, ownerGeneration, producerToken; };
+struct HPGeometry {
+    uint32_t width,height,format,reserved;
+    uint64_t aperturePitch,apertureLength;
+};
+struct HPCompletedLease {
+    uint64_t cpuAddress,validLength,pitch,leaseIdentity,sourceIdentity;
+    uint32_t flags,reserved;
+};
+struct HPDescribe { HPHeader header; uint64_t expectedOutput; };
+struct HPAcquire { HPHeader header; HPTicket expected; uint32_t owner,reserved; };
+struct HPRevoke { HPHeader header; HPTicket ticket; };
+struct HPSampleRequest { uint64_t firstByte; uint32_t strideBytes,count; };
+struct HPCommit {
+    HPHeader header;
+    uint32_t flags,reserved; /* Only bounded VERIFY_COMPOSED. No partial/D API. */
+    HPTicket ticket;
+    uint64_t serial;
+    HPGeometry geometry;
+    HPCompletedLease source;
+    HPSampleRequest sample; /* Diagnostic only; bounded visible-A words. */
+};
+struct HPVerification {
+    uint64_t comparedWords,badWords,firstByte;
+    uint32_t expected,actual,minX,minY,maxX,maxY;
+    uint32_t attempted,complete;
+};
+struct HPWordSamples { uint32_t attempted,count; uint32_t words[HP_MAX_SAMPLE_WORDS]; };
+struct HPReply {
+    HPHeader header;
+    HPStatus status;
+    uint32_t coreStatus,flags,reserved;
+    HPTicket ticket;
+    HPGeometry geometry;
+    uint64_t acceptedSerial;
+    HPVerification verification;
+    HPWordSamples samples;
+};
+static_assert(sizeof(uintptr_t)==8,"completed-frame ABI requires qualified x86_64 kernel");
+static_assert(sizeof(HPTicket)==32 && sizeof(HPGeometry)==32 && sizeof(HPCompletedLease)==48,"ABI layout");
+static_assert(sizeof(HPDescribe)==16 && sizeof(HPAcquire)==48 && sizeof(HPRevoke)==40,"ABI requests");
+static_assert(sizeof(HPCommit)==152 && sizeof(HPReply)==320 && sizeof(HPVerification)==56,"ABI commit/result");
+static_assert(offsetof(HPCommit,source)==88 && offsetof(HPReply,geometry)==56,"ABI offsets");
+#endif
