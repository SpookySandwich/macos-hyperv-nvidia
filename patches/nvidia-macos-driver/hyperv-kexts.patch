+// BEGIN HYPERV-CARRY: console head registration, KAPI staging VRAM and the console allocation records
+bool NVAccel::configureConsolePresentation(IOService *fb)
+{
+    if (!fb || !fPCI || fb != fFB || fb->getProvider() != fPCI || !nvConsoleFramebuffer(fb) ||
+        fPCI->configRead16(0) != 0x10de || fPCI->configRead16(2) != 0x28a0 ||
+        fPCI->getProperty("HyperVPCIUsesNegotiatedResources") != kOSBooleanTrue)
+        return false;
+    NVRMVramRequest q = {};
+    q.version = NVRM_VRAM_ABI_VERSION;
+    if (nvPrivatePublication(fb)) {
+        if (fb->callPlatformFunction("HyperVPublicationBindV1", false, this, nullptr, nullptr, nullptr) != kIOReturnSuccess)
+            return false;
+        HPReply description = {};
+        if (!nvPublicationDescribe(fb, &description)) return false;
+        q.width = description.geometry.width; q.height = description.geometry.height;
+        q.pitch = static_cast<UInt32>(description.geometry.aperturePitch); q.actualSize = uint64_t(q.pitch) * q.height;
+    } else if (askFramebufferForScanout(&q, fb) != kIOReturnSuccess || !q.kva || !q.actualSize)
+        return false; // enableController retries after committed geometry exists
+    OSDictionary *caps = OSDictionary::withCapacity(2);
+    if (!caps) return false;
+    caps->setObject("DisplayPipeSupported", kOSBooleanTrue);
+    caps->setObject("TransactionsSupported", kOSBooleanTrue);
+    setProperty("IOAccelDisplayPipeCapabilities", caps);
+    caps->release();
+    gNvIop = 1;
+    gNvScanout = 1;
+    gNvAperture = 1;
+    registerFramebuffer(1);
+    const bool piped = (gNvHeadsPiped & 1u) != 0;
+    ALOG("Hyper-V console ready: %ux%u pitch %u, registered 0x%x piped 0x%x",
+         q.width, q.height, q.pitch, gNvHeadsRegistered, gNvHeadsPiped);
+    // 2.3.1 boot guard (nvrm_off.h): only NVRMFB clears nullmoth-nv-starts, and here the display is the Hyper-V console,
+    // so NVRMFB may never reach its clear. A console head with a display pipe is this driver's display path being up:
+    // clear the counter exactly as NVRMFB would, so two such boots do not turn the driver off on the third.
+    if (piped) nvrm_guard_display_up("the Hyper-V console head has a display pipe");
+    return piped;
+}
