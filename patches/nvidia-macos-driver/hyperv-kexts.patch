+IOReturn NVAccel::consoleAllocateOwner(NVVidMemory *owner, NVRMVramRequest *request)
+{
+    if (!owner || !request || request->version != NVRM_VRAM_ABI_VERSION || !fConsoleLock)
+        return kIOReturnBadArgument;
+    IOLockLock(fConsoleLock);
+    const IOReturn result = consoleAllocateLocked(request, owner);
+    IOLockUnlock(fConsoleLock);
+    return result;
