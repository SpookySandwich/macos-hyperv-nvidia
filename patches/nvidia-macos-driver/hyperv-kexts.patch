+    OSData *vendor = OSDynamicCast(OSData, gpu->getProperty("vendor-id"));
+    OSData *device = OSDynamicCast(OSData, gpu->getProperty("device-id"));
+    return vendor && device && vendor->getLength() == 4 && device->getLength() == 4 &&
+        *(const UInt32 *)vendor->getBytesNoCopy() == 0x10de &&
