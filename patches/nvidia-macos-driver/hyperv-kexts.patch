+IOReturn NVAccel::consoleVram(NVRMVramRequest *request, bool alloc)
+{
+    if (!request || request->version != NVRM_VRAM_ABI_VERSION || !fConsoleLock)
+        return kIOReturnBadArgument;
+    IOLockLock(fConsoleLock);
+    IOReturn result = kIOReturnBadArgument;
+    unsigned releases = 0;
+    if (alloc) result = consoleAllocateLocked(request, nullptr);
+    else {
+        for (NvConsoleAllocation *r = fConsoleAllocations; r; r = r->next) {
+            if (r->memory.handle != request->handle || r->memory.allocationCookie != request->allocationCookie) continue;
+            // A raw handle/cookie call can never retire a VM-owned record, including a detached one held by a pin.
+            if (r->ownerBound) break;
+            r->retiring = true;
+            request->handle = request->kva = nullptr; request->phys = request->actualSize = 0;
+            result = kIOReturnSuccess; break;
+        }
+        releases = consoleReapLocked();
+    }
+    IOLockUnlock(fConsoleLock);
+    while (releases--) release(); // no field access after the final release
+    return result;
+}
