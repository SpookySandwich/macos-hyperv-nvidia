+IOReturn NVAccel::consoleUnparkOwner(NVVidMemory *owner, UInt64 want)
+{
+    if (!fConsoleLock) return kIOReturnNotFound;
+    IOReturn result = kIOReturnNotFound;
+    IOLockLock(fConsoleLock);
+    for (NvConsoleAllocation *r = fConsoleAllocations; r; r = r->next) {
+        if (!r->ownerBound || r->owner != owner || r->retiring || !r->parked) continue;
