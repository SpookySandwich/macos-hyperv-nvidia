+    if (bytes > NVRM_VRAM_BAR1_BUDGET - fConsoleBytes) return kIOReturnNoMemory;
+    NvConsoleAllocation *record = static_cast<NvConsoleAllocation *>(IOMalloc(sizeof(NvConsoleAllocation)));
+    if (!record) return kIOReturnNoMemory;
