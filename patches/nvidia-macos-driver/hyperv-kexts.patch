+// Detach the owner's record (active or parked) and retire it; its memory is freed once no pin holds it. The caller
+// has claimed the binding retain and keeps it until this returns.
+void NVAccel::consoleReleaseOwner(NVVidMemory *owner, NVRMVramRequest *released)
+{
+    if (!fConsoleLock) return;
+    IOLockLock(fConsoleLock);
+    for (NvConsoleAllocation *r = fConsoleAllocations; r; r = r->next) {
+        if (!r->ownerBound || r->owner != owner || r->retiring) continue;
+        *released = r->memory;
+        r->owner = nullptr; r->retiring = true; r->parked = false;
+        owner->fRmHandle = nullptr; owner->fKva = nullptr; owner->fPhys = 0;
+        owner->fBytes = 0; owner->fAllocationCookie = 0;
+        break;
+    }
+    const unsigned releases = consoleReapLocked();
+    IOLockUnlock(fConsoleLock);
+    for (unsigned i = 0; i < releases; ++i) release();
